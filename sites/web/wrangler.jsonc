{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "canmyagentuse",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "canmyagentuse.com",
      "custom_domain": true
    },
    {
      "pattern": "www.canmyagentuse.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://canmyagentuse.com"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
  // Bindings for later (do not uncomment until a route needs them):
  // "kv_namespaces": [{ "binding": "CATALOG_CACHE", "id": "<kv-id>" }]
  // "d1_databases": [{ "binding": "CATALOG_DB", "database_name": "canmyagentuse", "database_id": "<d1-id>" }]
}
