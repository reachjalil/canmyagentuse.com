---
import {
  MACHINE_PATHS,
  SITE,
  jsonPathForPagePath,
  markdownPathForPagePath,
} from "@canmyagentuse/catalog";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  jsonLd?: unknown[];
  noindex?: boolean;
  socialTitle?: string;
  socialDescription?: string;
  socialImagePath?: string;
  socialImageAlt?: string;
  contentType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  section?: string;
  tags?: string[];
}

const {
  title,
  description,
  canonicalPath,
  jsonLd = [],
  noindex = false,
  socialTitle = title,
  socialDescription = description,
  socialImagePath,
  socialImageAlt,
  contentType = "website",
  publishedTime,
  modifiedTime,
  section,
  tags = [],
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(canonicalPath, site);
const markdownPath = markdownPathForPagePath(canonical.pathname);
const jsonPath = jsonPathForPagePath(canonical.pathname);
const normalizedCanonicalPath = canonicalPath.replace(/\/+$/, "") || "/";
const socialCardKey =
  normalizedCanonicalPath === "/"
    ? "home"
    : normalizedCanonicalPath.slice(1).replaceAll("/", "--");
const resolvedSocialImagePath =
  socialImagePath ??
  (noindex ? SITE.socialImagePath : `/social/${socialCardKey}.png`);
const socialImage = new URL(resolvedSocialImagePath, site);
const resolvedSocialImageAlt =
  socialImageAlt ??
  `${socialTitle} — an independent Can My Agent Use compatibility catalog card.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="only light" />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="author" content={SITE.name} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    <meta property="og:type" content={contentType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta property="og:image:url" content={socialImage.toString()} />
    <meta property="og:image:secure_url" content={socialImage.toString()} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedSocialImageAlt} />
    {publishedTime ? <meta property="article:published_time" content={publishedTime.toISOString()} /> : null}
    {modifiedTime ? <meta property="article:modified_time" content={modifiedTime.toISOString()} /> : null}
    {section ? <meta property="article:section" content={section} /> : null}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage.toString()} />
    <meta name="twitter:image:alt" content={resolvedSocialImageAlt} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="search" type="application/opensearchdescription+xml" title={`Search ${SITE.name}`} href="/opensearch.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} news`} href={new URL("/feed.xml", site).toString()} />
    <link rel="alternate" type="application/feed+json" title={`${SITE.name} news`} href={new URL("/feed.json", site).toString()} />
    {markdownPath ? <link rel="alternate" type="text/markdown" href={new URL(markdownPath, site).toString()} /> : null}
    {jsonPath ? <link rel="alternate" type="application/json" href={new URL(jsonPath, site).toString()} /> : null}
    <link rel="index" type="text/plain" title={`${SITE.name} agent index`} href={new URL(MACHINE_PATHS.llms, site).toString()} />
    <link rel="api-catalog" type="application/linkset+json" href={new URL(MACHINE_PATHS.apiCatalog, site).toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {
      jsonLd.map((node) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
