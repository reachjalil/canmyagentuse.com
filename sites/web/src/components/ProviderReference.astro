---
import {
  referenceIdentity,
  type ProviderMarkAuthorization,
} from "@canmyagentuse/catalog";
import ProviderMark from "./ProviderMark.astro";

interface Props {
  provider: string;
  product?: string;
  productSlug?: string;
  surface?: string;
  homepage?: string;
  catalogPath?: string;
  evidenceLabel?: string;
  compact?: boolean;
  mark?: ProviderMarkAuthorization;
}

const {
  provider,
  product,
  productSlug,
  surface,
  homepage,
  catalogPath,
  evidenceLabel,
  compact = false,
  mark,
} = Astro.props;
const reference = referenceIdentity({ provider, product, productSlug });
const primaryName = product ?? provider;
const referenceKind = product ? "Product" : "Provider";
---

<div
  class:list={["provider-reference", { "provider-reference--compact": compact }]}
  data-provider-tone={reference.tone}
>
  <ProviderMark provider={provider} productSlug={productSlug} mark={mark} />
  <div class="provider-reference__body">
    <span class="provider-reference__label">{referenceKind}</span>
    <strong>{primaryName}</strong>
    {product && product !== provider ? <span class="provider-reference__product">{provider}</span> : null}
    {
      surface || evidenceLabel ? (
        <span class="provider-reference__meta">
          {[surface, evidenceLabel].filter(Boolean).join(" · ")}
        </span>
      ) : null
    }
  </div>
  {
    homepage || catalogPath ? (
      <nav class="provider-reference__links" aria-label={`${provider} references`}>
        {homepage ? (
          <a href={homepage} rel="noopener noreferrer">
            {product ? "Product site" : "Provider site"} <span aria-hidden="true">↗</span>
          </a>
        ) : null}
        {catalogPath ? <a href={catalogPath}>Research profile <span aria-hidden="true">→</span></a> : null}
      </nav>
    ) : null
  }
</div>
