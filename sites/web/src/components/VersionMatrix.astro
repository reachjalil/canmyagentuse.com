---
import {
  ASSESSMENT_BASIS_LABELS,
  ASSESSMENT_CONFIDENCE_LABELS,
  HARNESS_SURFACE_LABELS,
  SUPPORT_STATUS_LABELS,
  TRACK_LABELS,
  assessmentBasisForVersion,
  assessmentConfidenceForVersion,
  currentSupportSnapshot,
  expandFeatureSupport,
  groupHarnesses,
  hasDirectReviewedEvidence,
  type FeatureData,
  type HarnessData,
  type VersionCell,
} from "@canmyagentuse/catalog";
import ProviderMark from "./ProviderMark.astro";
import StatusMark from "./StatusMark.astro";

interface Props {
  feature: FeatureData;
  harnesses: HarnessData[];
}

const { feature, harnesses } = Astro.props;
const columns = expandFeatureSupport(feature, harnesses);
const groups = groupHarnesses(harnesses);
const columnMap = new Map(columns.map((column) => [column.harness.slug, column]));
const currentCells = columns
  .map((column) => column.versions.find((version) => version.track === "current"))
  .filter((version): version is VersionCell => Boolean(version));
const snapshot = currentSupportSnapshot(columns);
const statusCounts = ["yes", "partial", "no", "unknown", "na"].map((status) => ({
  status,
  count: snapshot.counts[status as keyof typeof snapshot.counts],
}));

function evidenceLabel(version: VersionCell) {
  if (version.status === "unknown") return "Insufficient information";
  const date = version.target?.observedAt ?? version.evidence?.[0]?.observedAt;
  if (version.target?.kind === "release") return version.target.revision;
  if (version.target?.kind === "hosted-observation") {
    return date ? `Observed ${date}` : "Hosted product";
  }
  if (version.target?.kind === "dated-documentation") {
    return date ? `Docs checked ${date}` : "Current documentation";
  }
  return date ? `Checked ${date}` : "Evidence recorded";
}

function assessmentLabel(version: VersionCell) {
  const basis = assessmentBasisForVersion(version);
  const confidence = assessmentConfidenceForVersion(version);
  if (!basis) return "No responsible assessment yet";
  return [
    ASSESSMENT_BASIS_LABELS[basis],
    confidence ? ASSESSMENT_CONFIDENCE_LABELS[confidence] : "",
  ].filter(Boolean).join(" · ");
}

function correctionHref(harness: HarnessData, version: VersionCell) {
  const params = new URLSearchParams({
    targetType: "cell",
    feature: feature.slug,
    harness: harness.slug,
    track: version.track,
    status: version.status,
    assessment: version.noteIds
      .map((id) => feature.notes.find((note) => note.id === id)?.text)
      .filter(Boolean)
      .join(" "),
    sources: (version.evidence ?? [])
      .map((item) => feature.resources.find((resource) => resource.id === item.resourceId)?.href)
      .filter(Boolean)
      .join("\n"),
    assessedAt:
      version.assessedAt ??
      version.target?.observedAt ??
      version.evidence?.[0]?.observedAt ??
      "",
    permalink: `https://canmyagentuse.com/features/${feature.slug}#cell-${harness.slug}-${version.track}`,
  });
  return `/report?${params.toString()}`;
}
---

<section class="support-summary mt-8" data-matrix aria-labelledby="support-summary-title">
  <header class="support-summary__header">
    <div>
      <p class="eyebrow">Current assessment by product</p>
      <h2 id="support-summary-title">Can my agent use {feature.title}?</h2>
      <p>
        {snapshot.assessed} checks assessed · {snapshot.counts.yes} supported ·{" "}
        {snapshot.counts.partial} partial · {snapshot.counts.no} unsupported ·{" "}
        {snapshot.counts.unknown} unknown.
      </p>
      <p>
        {snapshot.directEvidence} of {currentCells.length} checks have direct reviewed evidence.
        Other assessments show their basis and confidence when opened.
      </p>
    </div>
    <div class="support-summary__actions">
      <a href="#known-issues">Known issues ({feature.issues.length})</a>
      <a class="support-summary__report" href={`/report?targetType=feature&feature=${feature.slug}`}>Suggest a correction</a>
    </div>
  </header>

  <div class="support-summary__toolbar">
    <div class="matrix-tabs" role="tablist" aria-label="Support records">
      <button type="button" role="tab" aria-selected="true" data-view="current">
        Current
      </button>
      <button type="button" role="tab" aria-selected="false" data-view="all">
        All records
      </button>
    </div>
    <ul class="support-counts" aria-label="Current support totals">
      {
        statusCounts.map(({ status, count }) => (
          <li data-status={status}>
            <span>{SUPPORT_STATUS_LABELS[status as keyof typeof SUPPORT_STATUS_LABELS]}</span>
            <strong>{count}</strong>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="support-board" data-view="current">
    {
      groups.map((group) => (
        <section class="support-band" aria-labelledby={`surface-${group.surface}`}>
          <header class="support-band__label">
            <h3 id={`surface-${group.surface}`}>{HARNESS_SURFACE_LABELS[group.surface]}</h3>
            <span>{group.items.length} products</span>
          </header>
          <div class="support-band__columns">
            {group.items.map((harness) => {
              const column = columnMap.get(harness.slug);
              return (
                <article class="support-column">
                  <header class="support-column__head">
                    <a href={`/harnesses/${harness.slug}`}>
                      <ProviderMark provider={harness.vendor} productSlug={harness.slug} variant="inline" />
                      {harness.title}
                    </a>
                    <small>{harness.family}</small>
                  </header>
                  <div class="support-column__records">
                    {(column?.versions ?? []).map((version) => (
                      <details
                        class="support-record"
                        id={`cell-${harness.slug}-${version.track}`}
                        data-status={version.status}
                        data-track={version.track}
                      >
                        <summary
                          title={`${harness.title}, ${TRACK_LABELS[version.track] ?? version.track}: ${SUPPORT_STATUS_LABELS[version.status]}${version.qualifiers?.length ? `. Conditions: ${version.qualifiers.map((item) => `${item.type}=${item.value}`).join("; ")}` : ""}`}
                        >
                          <div class="support-record__status">
                            <StatusMark
                              status={version.status}
                              noteIds={version.noteIds}
                              assessmentLabel={assessmentLabel(version)}
                              showAssessmentMarker={version.status !== "unknown" && !hasDirectReviewedEvidence(version)}
                            />
                            <strong>{SUPPORT_STATUS_LABELS[version.status]}</strong>
                          </div>
                          <span>{evidenceLabel(version)}</span>
                          <small>
                            {TRACK_LABELS[version.track] ?? version.track}
                            {version.qualifiers?.length
                              ? ` · ${version.qualifiers.length} ${version.qualifiers.length === 1 ? "condition" : "conditions"}`
                              : " record"}
                          </small>
                        </summary>
                        <div class="support-record__details">
                          <p><strong>{SUPPORT_STATUS_LABELS[version.status]}</strong> — {assessmentLabel(version)}</p>
                          {version.qualifiers?.length ? (
                            <ul>
                              {version.qualifiers.map((item) => <li><strong>{item.type}:</strong> {item.value}</li>)}
                            </ul>
                          ) : null}
                          {(version.evidence ?? []).length ? (
                            <p>
                              {(version.evidence ?? []).map((item, index) => {
                                const resource = feature.resources.find((candidate) => candidate.id === item.resourceId);
                                return resource ? <><a href={resource.href}>{resource.title}</a>{index < (version.evidence?.length ?? 0) - 1 ? " · " : ""}</> : null;
                              })}
                            </p>
                          ) : null}
                          <a class="support-record__correction" href={correctionHref(harness, version)}>
                            Suggest a correction
                          </a>
                        </div>
                      </details>
                    ))}
                  </div>
                  <a
                    class="support-column__report"
                    href={`/report?targetType=cell&feature=${feature.slug}&harness=${harness.slug}&track=current`}
                  >
                    Suggest a correction
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>

  <footer class="support-summary__footer">
    <p>
      <strong>Unknown</strong> means there is not enough information for a responsible assessment.
      An outlined dot marks an editorial assessment; it keeps the primary support color unchanged.
    </p>
    <a href="/methodology">How statuses are assigned</a>
  </footer>
</section>

<script>
  const root = document.querySelector("[data-matrix]");
  if (root) {
    const board = root.querySelector(".support-board");
    const tabs = root.querySelectorAll('[role="tab"]');
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const view = tab.getAttribute("data-view");
        if (!view || !board) return;
        board.setAttribute("data-view", view);
        for (const other of tabs) {
          other.setAttribute("aria-selected", other === tab ? "true" : "false");
        }
      });
    }
  }
</script>

<style>
  .support-summary {
    border: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .support-summary__header {
    display: grid;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line);
    padding: 1rem;
  }

  .support-summary__header h2 {
    margin: 0;
    font-size: 1.65rem;
    letter-spacing: -0.035em;
  }

  .support-summary__header p:last-child {
    max-width: 44rem;
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .support-summary__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 0.45rem;
  }

  .support-summary__actions a {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    border: 1px solid var(--color-line);
    padding: 0.45rem 0.7rem;
    font-size: 0.78rem;
    text-decoration: none;
  }

  .support-summary__actions .support-summary__report {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .support-summary__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-canvas) 55%, var(--color-paper));
    padding: 0.7rem 1rem;
  }

  .support-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .support-counts li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    padding: 0.25rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .support-counts li::before {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--status-color);
    content: "";
  }

  .support-counts li[data-status="yes"] { --status-color: #2a6f54; }
  .support-counts li[data-status="partial"] { --status-color: #b07a22; }
  .support-counts li[data-status="no"] { --status-color: #8f3a2a; }
  .support-counts li[data-status="unknown"] { --status-color: #b9ad97; }
  .support-counts li[data-status="na"] { --status-color: #ebe3d3; }

  .support-band + .support-band {
    border-top: 0.3rem solid var(--color-ink);
  }

  .support-band__label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 0.5rem 0.7rem;
  }

  .support-band__label h3 {
    margin: 0;
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .support-band__label span {
    color: color-mix(in srgb, var(--color-paper) 72%, var(--color-ink));
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .support-band__columns {
    display: grid;
    grid-auto-columns: minmax(8.7rem, 1fr);
    grid-auto-flow: column;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .support-column {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border-right: 1px solid var(--color-line);
  }

  .support-column:last-child { border-right: 0; }

  .support-column__head {
    min-height: 4.4rem;
    border-top: 0.28rem solid var(--color-copper-deep);
    border-bottom: 1px solid var(--color-line);
    padding: 0.55rem 0.6rem 0.45rem;
  }

  .support-column__head a {
    display: flex;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }

  .support-column__head .provider-inline-token {
    margin-right: 0.4rem;
  }

  .support-column__head a:hover {
    text-decoration: underline;
    text-underline-offset: 0.15rem;
  }

  .support-column__head small {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .support-column__records {
    flex: 1;
    padding: 0.35rem;
  }

  .support-record {
    min-height: 6.8rem;
    border: 1px solid rgb(18 16 14 / 16%);
    background: var(--status-bg);
    color: var(--status-ink);
  }

  .support-record summary {
    min-height: 6.7rem;
    padding: 0.55rem;
    cursor: pointer;
    list-style: none;
  }

  .support-record summary::-webkit-details-marker {
    display: none;
  }

  .support-record + .support-record { margin-top: 0.3rem; }
  .support-record[data-status="yes"] { --status-bg: #2a6f54; --status-ink: #f4fff8; }
  .support-record[data-status="partial"] { --status-bg: #8c5f19; --status-ink: #fff8eb; }
  .support-record[data-status="no"] { --status-bg: #8f3a2a; --status-ink: #fff4ef; }
  .support-record[data-status="unknown"] { --status-bg: #d2c6b0; --status-ink: #3a342c; }
  .support-record[data-status="na"] { --status-bg: #ebe3d3; --status-ink: #6e675d; }

  .support-record__status {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .support-record__status strong { font-size: 0.78rem; }

  .support-record summary > span,
  .support-record summary > small {
    display: block;
    margin-top: 0.42rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.35;
  }

  .support-record summary > small {
    margin-top: 0.22rem;
    opacity: 0.76;
  }

  .support-record__details {
    border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    background: color-mix(in srgb, var(--status-bg) 86%, #fff);
    padding: 0.55rem;
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .support-record__details p,
  .support-record__details ul {
    margin: 0;
  }

  .support-record__details ul {
    padding-left: 1rem;
  }

  .support-record__details > * + * {
    margin-top: 0.55rem;
  }

  .support-record__details a {
    color: inherit;
  }

  .support-record__correction {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    border: 1px solid currentColor;
    padding: 0.3rem 0.45rem;
    font-weight: 600;
    text-underline-offset: 0.14rem;
  }

  :global(.assessment-marker) {
    margin-left: 0.18rem;
    font-size: 0.72em;
  }

  .support-column__report {
    display: flex;
    min-height: 2.2rem;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-align: center;
    text-underline-offset: 0.15rem;
  }

  .support-board[data-view="current"]
    .support-record[data-track]:not([data-track="current"]) {
    display: none;
  }

  .support-summary__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-top: 1px solid var(--color-line);
    padding: 0.75rem 1rem;
    color: var(--color-muted);
    font-size: 0.76rem;
  }

  .support-summary__footer p {
    max-width: 48rem;
    margin: 0;
  }

  .support-summary__footer a { font-weight: 500; }

  @media (min-width: 800px) {
    .support-summary__header {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }

    .support-summary__actions { justify-content: flex-end; }
  }

  @media (max-width: 620px) {
    .support-summary { margin-inline: -0.5rem; }

    .support-counts span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
