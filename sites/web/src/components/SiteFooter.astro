---
import { MACHINE_PATHS, SITE } from "@canmyagentuse/catalog";

const links = [
  { href: "/sponsors", label: "Sponsorship & advertising" },
  { href: "/products", label: "Products your agent can use" },
  { href: "/features", label: "Capabilities" },
  { href: "/harnesses", label: "Agent harnesses" },
  { href: "/harness-guide", label: "Harness evaluation guide" },
  { href: "/compare", label: "Compare" },
  { href: "/matrix", label: "Matrix" },
  { href: "/specs", label: "Specifications" },
  { href: "/evidence", label: "Evidence" },
  { href: "/coverage", label: "Coverage" },
  { href: "/reports", label: "Reports" },
  { href: "/tests", label: "Conformance tests" },
  { href: "/changes", label: "Changes" },
  { href: "/contradictions", label: "Contradictions" },
  { href: "/report", label: "Suggest a correction" },
  { href: "/report?targetType=missing-harness", label: "Request an agent harness" },
  { href: "/report?targetType=missing-feature", label: "Request a capability" },
  { href: "/contribute", label: "Contribute" },
  { href: "/prompt", label: "Prompt this catalog" },
  { href: "/news", label: "News" },
  { href: "/methodology", label: "Methodology" },
  { href: "/about", label: "About" },
  { href: "/provider-marks", label: "Brand references" },
  { href: "/press", label: "Press kit" },
  { href: "/privacy", label: "Privacy" },
];
---

<footer class="site-footer mt-16">
  <div class="shell grid gap-8 py-10 text-sm md:grid-cols-[1.4fr_1fr_auto]">
    <div class="space-y-2">
      <p class="font-medium text-[color:var(--color-chrome-ink)]">{SITE.name}</p>
      <p>{SITE.independentNotice}</p>
      <p>{SITE.foundationNotice}</p>
    </div>
    <nav aria-label="Site">
      <ul class="space-y-1">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Catalog copies">
      <ul class="space-y-1 font-mono text-xs">
        <li><a href={MACHINE_PATHS.productsJson}>/api/v1/products.json</a></li>
        <li><a href={MACHINE_PATHS.llms}>/llms.txt</a></li>
        <li><a href={MACHINE_PATHS.promptText}>/prompt.txt</a></li>
        <li><a href={MACHINE_PATHS.feedXml}>/feed.xml</a></li>
        <li><a href={MACHINE_PATHS.llmsFull}>/llms-full.txt</a></li>
        <li><a href={MACHINE_PATHS.openapi}>/api/v1/openapi.json</a></li>
        <li><a href={MACHINE_PATHS.harnessesJson}>/api/v1/harnesses.json</a></li>
        <li><a href={MACHINE_PATHS.specificationsJson}>/api/v1/specs.json</a></li>
        <li><a href={MACHINE_PATHS.evidenceJson}>/api/v1/evidence.json</a></li>
        <li><a href={MACHINE_PATHS.coverageJson}>/api/v1/coverage.json</a></li>
        <li><a href={MACHINE_PATHS.reportsJson}>/api/v1/reports.json</a></li>
        <li><a href={MACHINE_PATHS.testsJson}>/api/v1/tests.json</a></li>
        <li><a href={MACHINE_PATHS.matrixJson}>/api/v1/matrix.json</a></li>
      </ul>
    </nav>
  </div>
</footer>
