---
import {
  SUPPORT_STATUS_LABELS,
  SUPPORT_STATUS_MARK,
  type SupportStatus,
} from "@canmyagentuse/catalog";

interface Props {
  status: SupportStatus;
  noteIds?: number[];
  assessmentLabel?: string;
  showAssessmentMarker?: boolean;
}

const {
  status,
  noteIds = [],
  assessmentLabel,
  showAssessmentMarker = false,
} = Astro.props;
const label = SUPPORT_STATUS_LABELS[status];
---

<span class={`status-${status}`} aria-label={assessmentLabel ? `${label}. ${assessmentLabel}` : label}>
  <abbr title={label} aria-hidden="true">{SUPPORT_STATUS_MARK[status]}</abbr>
  {
    showAssessmentMarker ? (
      <span class="assessment-marker" aria-hidden="true" title={assessmentLabel}>○</span>
    ) : null
  }
  {
    noteIds.length > 0 ? (
      <sup class="font-mono text-[0.65rem]">
        {noteIds.join(",")}
      </sup>
    ) : null
  }
</span>
