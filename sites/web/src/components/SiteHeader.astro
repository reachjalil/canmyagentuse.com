---
import { SITE, type NewsData } from "@canmyagentuse/catalog";

interface Props {
  latest?: NewsData;
}

const { latest } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "Home" },
  { href: "/products", label: "Products" },
  { href: "/matrix", label: "Matrix" },
  { href: "/harnesses", label: "Harnesses" },
  { href: "/compare", label: "Compare" },
  { href: "/atlas", label: "Atlas" },
  { href: "/reports", label: "Reports" },
  { href: "/specs", label: "Specs" },
  { href: "/evidence", label: "Evidence" },
  { href: "/coverage", label: "Coverage" },
];

function isCurrent(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="shell flex flex-wrap items-center gap-3 py-2 text-sm">
    <a class="brand-lockup" href="/">
      <img src={SITE.markPath} alt="" width="34" height="34" />
      <span>
        <strong>Can My Agent Use</strong>
        <small>products · setup · evidence</small>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                class="inline-block px-2.5 py-1.5"
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      latest ? (
        <p class="news-ticker ml-auto font-mono text-xs">
          <a href={`/news/${latest.slug}`}>
            {latest.published
              ? latest.published.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })
              : ""}
            {" · "}
            {latest.title}
          </a>
        </p>
      ) : (
        <p class="news-ticker ml-auto font-mono text-xs opacity-70">
          Independent catalog
        </p>
      )
    }
  </div>
</header>
