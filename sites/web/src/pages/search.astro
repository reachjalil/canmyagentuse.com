---
export const prerender = false;

import { SITE, searchCatalog, websiteJsonLd } from "@canmyagentuse/catalog";
import SiteChrome from "../components/SiteChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publishedCollection } from "../lib/collections";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const requestedScope = Astro.url.searchParams.get("scope") ?? "all";
const searchScope = (["all", "feature", "harness", "specification"] as const).find(
  (scope) => scope === requestedScope
) ?? "all";
const [features, harnesses, specifications] = await Promise.all([
  publishedCollection("features"),
  publishedCollection("harnesses"),
  publishedCollection("specifications"),
]);
const results = searchCatalog(query, {
  features: features.map((entry) => entry.data),
  harnesses: harnesses.map((entry) => entry.data),
  specifications: specifications.map((entry) => entry.data),
});
const hits = searchScope === "all"
  ? results.hits
  : results.hits.filter((hit) => hit.kind === searchScope);
const kindLabels = {
  feature: "Capability",
  harness: "Product",
  specification: "Specification",
} as const;
const scopeLabels = {
  all: "the complete catalog",
  feature: "capabilities",
  harness: "products",
  specification: "specifications",
} as const;
---

<BaseLayout
  title={`${query ? `Search: ${query}` : "Search the catalog"} | ${SITE.name}`}
  description="Search capabilities, exact web, desktop, and CLI products, and specification references from one catalog index."
  canonicalPath="/search"
  noindex={Boolean(query)}
  jsonLd={[websiteJsonLd()]}
>
  <SiteChrome searchValue={query} searchScope={searchScope}>
    <main id="main" class="shell py-8">
      <p class="eyebrow">Capabilities, products, and specifications</p>
      <h1 class="text-4xl font-semibold tracking-tight">Search the catalog</h1>
      {
        query ? (
          <p class="mt-3 max-w-3xl text-lg text-[color:var(--color-muted)]">
            {hits.length} {hits.length === 1 ? "result" : "results"} for <strong>"{query}"</strong>{" "}
            in {scopeLabels[searchScope]}.
          </p>
        ) : (
          <p class="mt-3 max-w-3xl text-lg text-[color:var(--color-muted)]">
            Enter a capability, product, provider, protocol, alias, or revision
            in the search box above.
          </p>
        )
      }

      {
        query && hits.length === 0 ? (
          <div class="empty-state mt-8">
            <h2>No catalog record matched</h2>
            <p>
              Try a shorter protocol name, a provider family, or browse the
              complete <a href="/features">capability index</a> and <a href="/harnesses">product index</a>.
            </p>
          </div>
        ) : null
      }

      {
        query && hits.length > 0 ? (
          <ol class="search-results mt-8">
            {hits.map((hit) => (
              <li>
                <a href={hit.path}>
                  <span class="search-result__kind">{kindLabels[hit.kind]}</span>
                  <h2>{hit.title}</h2>
                  <p>{hit.summary}</p>
                  <small>{hit.meta}</small>
                </a>
              </li>
            ))}
          </ol>
        ) : null
      }

      {
        !query ? (
          <nav class="search-starts mt-8" aria-label="Catalog starting points">
            <a href="/features"><strong>{features.length}</strong><span>Capabilities</span></a>
            <a href="/harnesses"><strong>{harnesses.length}</strong><span>Harness surfaces</span></a>
            <a href="/specs"><strong>{specifications.length}</strong><span>Specifications</span></a>
          </nav>
        ) : null
      }
    </main>
  </SiteChrome>
</BaseLayout>
