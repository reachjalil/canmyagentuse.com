---
export const prerender = false;

import { SITE, SUPPORT_STAGES, SUPPORT_STATUSES, searchCatalog, websiteJsonLd } from "@canmyagentuse/catalog";
import ProviderMark from "../components/ProviderMark.astro";
import SiteChrome from "../components/SiteChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publishedCollection } from "../lib/collections";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const requestedScope = Astro.url.searchParams.get("scope") ?? "all";
const searchScope = (["all", "feature", "harness", "specification"] as const).find(
  (scope) => scope === requestedScope
) ?? "all";
const [features, harnesses, specifications] = await Promise.all([
  publishedCollection("features"),
  publishedCollection("harnesses"),
  publishedCollection("specifications"),
]);
const family = Astro.url.searchParams.get("family")?.trim() ?? "";
const harness = Astro.url.searchParams.get("harness")?.trim() ?? "";
const requestedSupport = Astro.url.searchParams.get("support")?.trim() ?? "";
const support = SUPPORT_STATUSES.find((candidate) => candidate === requestedSupport);
const requestedStage = Astro.url.searchParams.get("stage")?.trim() ?? "";
const stage = SUPPORT_STAGES.find((candidate) => candidate === requestedStage);
const activeSearch = Boolean(query || family || harness || support || stage);
const results = searchCatalog(query, {
  features: features.map((entry) => entry.data),
  harnesses: harnesses.map((entry) => entry.data),
  specifications: specifications.map((entry) => entry.data),
}, {
  family: family || undefined,
  harness: harness || undefined,
  support,
  stage,
});
const hits = searchScope === "all"
  ? results.hits
  : results.hits.filter((hit) => hit.kind === searchScope);
const kindLabels = {
  feature: "Capability",
  harness: "Product",
  specification: "Specification",
} as const;
const harnessBySlug = new Map(
  harnesses.map((entry) => [entry.data.slug, entry.data] as const)
);
const scopeLabels = {
  all: "the complete catalog",
  feature: "capabilities",
  harness: "products",
  specification: "specifications",
} as const;
---

<BaseLayout
  title={`${query ? `Search: ${query}` : "Search the catalog"} | ${SITE.name}`}
  description="Search capabilities, exact web, desktop, and CLI products, and specification references from one catalog index."
  canonicalPath="/search"
  noindex={Boolean(query)}
  jsonLd={[websiteJsonLd()]}
>
  <SiteChrome searchValue={query} searchScope={searchScope}>
    <main id="main" class="shell py-8">
      <p class="eyebrow">Capabilities, products, and specifications</p>
      <h1 class="text-4xl font-semibold tracking-tight">Search the catalog</h1>
      {
        activeSearch ? (
          <p class="mt-3 max-w-3xl text-lg text-[color:var(--color-muted)]">
            {hits.length} {hits.length === 1 ? "result" : "results"}{query ? <> for <strong>"{query}"</strong></> : null}{" "}
            in {scopeLabels[searchScope]}.
          </p>
        ) : (
          <p class="mt-3 max-w-3xl text-lg text-[color:var(--color-muted)]">
            Enter a capability, product, provider, protocol, alias, or revision
            in the search box above.
          </p>
        )
      }

      <form class="search-filters mt-6" method="get" action="/search">
        <input type="hidden" name="q" value={query} />
        {searchScope !== "all" ? <input type="hidden" name="scope" value={searchScope} /> : null}
        <label>Capability family
          <select name="family">
            <option value="">All families</option>
            {features.filter((entry) => entry.data.capabilityKind === "family").map((entry) => <option value={entry.data.slug} selected={entry.data.slug === family}>{entry.data.title}</option>)}
          </select>
        </label>
        <label>Product
          <select name="harness">
            <option value="">All products</option>
            {harnesses.map((entry) => <option value={entry.data.slug} selected={entry.data.slug === harness}>{entry.data.title} ({entry.data.surface})</option>)}
          </select>
        </label>
        <label>Current support
          <select name="support" disabled={!harness}>
            <option value="">Any status</option>
            {SUPPORT_STATUSES.map((candidate) => <option value={candidate} selected={candidate === support}>{candidate}</option>)}
          </select>
        </label>
        <label>Lifecycle
          <select name="stage" disabled={!harness}>
            <option value="">Any stage</option>
            {SUPPORT_STAGES.map((candidate) => <option value={candidate} selected={candidate === stage}>{candidate}</option>)}
          </select>
        </label>
        <button type="submit">Apply filters</button>
        {activeSearch ? <a href="/search">Clear</a> : null}
      </form>

      {
        activeSearch && hits.length === 0 ? (
          <div class="empty-state mt-8">
            <h2>No catalog record matched</h2>
            <p>
              Try a shorter protocol name, a provider family, or browse the
              complete <a href="/features">capability index</a> and <a href="/harnesses">product index</a>.
            </p>
          </div>
        ) : null
      }

      {
        activeSearch && hits.length > 0 ? (
          <ol class="search-results mt-8">
            {hits.map((hit) => (
              <li>
                <a href={hit.path}>
                  <div class="search-result__heading">
                    {hit.kind === "harness" ? (
                      <ProviderMark
                        provider={harnessBySlug.get(hit.slug)?.vendor ?? hit.meta}
                        productSlug={hit.slug}
                        variant="inline"
                      />
                    ) : null}
                    <span class="search-result__kind">{kindLabels[hit.kind]}</span>
                  </div>
                  <h2>{hit.title}</h2>
                  <p>{hit.summary}</p>
                  <small>{hit.meta}</small>
                </a>
              </li>
            ))}
          </ol>
        ) : null
      }

      {
        !activeSearch ? (
          <nav class="search-starts mt-8" aria-label="Catalog starting points">
            <a href="/features"><strong>{features.length}</strong><span>Capabilities</span></a>
            <a href="/harnesses"><strong>{harnesses.length}</strong><span>Harness surfaces</span></a>
            <a href="/specs"><strong>{specifications.length}</strong><span>Specifications</span></a>
          </nav>
        ) : null
      }
    </main>
  </SiteChrome>
</BaseLayout>
