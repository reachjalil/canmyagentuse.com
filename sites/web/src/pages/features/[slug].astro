---
import {
  breadcrumbJsonLd,
  buildCapabilityProgress,
  capabilityNode,
  currentSupportSnapshot,
  expandFeatureSupport,
  featureMarkdownPath,
  featurePath,
  formatPercent,
  resolveMetadata,
  techArticleJsonLd,
  SUPPORT_STATUS_LABELS,
} from "@canmyagentuse/catalog";
import { render } from "astro:content";
import NotesPanel from "../../components/NotesPanel.astro";
import AssertionLedger from "../../components/AssertionLedger.astro";
import ProviderMark from "../../components/ProviderMark.astro";
import SiteChrome from "../../components/SiteChrome.astro";
import VersionMatrix from "../../components/VersionMatrix.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entryBySlug, publishedCollection } from "../../lib/collections";
import { currentSupportSnippet } from "../../lib/support";

export async function getStaticPaths() {
  const features = await publishedCollection("features");
  return features.map((feature) => ({
    params: { slug: feature.data.slug },
  }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error("Missing feature slug.");

const features = await publishedCollection("features");
const harnesses = await publishedCollection("harnesses");
const feature = entryBySlug(features, slug);
if (!feature) {
  return Astro.redirect("/404");
}

const { Content } = await render(feature);
const metadata = resolveMetadata(feature.data);
const harnessData = harnesses.map((entry) => entry.data);
const columns = expandFeatureSupport(feature.data, harnessData);
const currentSupport = currentSupportSnapshot(columns);
const supportSnippet = currentSupportSnippet(feature.data.title, currentSupport);
const graph = capabilityNode(feature.data.slug, features.map((entry) => entry.data));
const familyProgress = feature.data.capabilityKind === "family"
  ? buildCapabilityProgress(feature.data.slug, features.map((entry) => entry.data), harnessData)
  : [];
const terminologyReference = feature.data.specification
  ? {
      title: feature.data.specLabel,
      href: feature.data.specification.canonicalUrl,
    }
  : feature.data.resources.find((resource) => resource.href.startsWith("https://"));
---

<BaseLayout
  title={metadata.seoTitle}
  description={supportSnippet}
  canonicalPath={metadata.canonicalPath}
  socialTitle={metadata.socialTitle}
  socialDescription={supportSnippet}
  socialImageAlt={metadata.previewImageAlt ?? `${metadata.socialTitle} compatibility card from Can My Agent Use.`}
  contentType="article"
  publishedTime={metadata.published}
  modifiedTime={metadata.updated}
  section={feature.data.category}
  tags={metadata.tags}
  jsonLd={[
    techArticleJsonLd(metadata),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Capabilities", path: "/features" },
      { name: feature.data.title, path: featurePath(feature.data.slug) },
    ]),
  ]}
>
  <SiteChrome searchValue={feature.data.title}>
    <main id="main" class="shell feature-page">
      <div class="feature-head">
        <div class="feature-head__copy">
          <p class="font-mono text-xs text-[color:var(--color-muted)]">
            {feature.data.capabilityKind === "family"
              ? "Catalog grouping"
              : feature.data.specification
                ? "Specification feature"
                : "Product feature"} · {feature.data.category}
          </p>
          <h1 class="mt-2 text-4xl font-semibold tracking-tight">
            {feature.data.title}
            {
              feature.data.specification ? (
                <a class="spec-pill" href={`/specs/${feature.data.specification.id}`}>
                  {feature.data.specLabel}
                </a>
              ) : (
                <span class="spec-pill">{feature.data.specLabel}</span>
              )
            }
          </h1>
          <p class="mt-4 max-w-2xl text-lg text-[color:var(--color-muted)]">
            {feature.data.summary}
          </p>
          <p class="term-basis">
            <strong>Terminology basis:</strong>{" "}
            {feature.data.capabilityKind === "family" ? (
              <>Catalog grouping with an optional broad practical assessment. Exact standard-format behaviors remain independent child checks.</>
            ) : terminologyReference ? (
              <>
                {feature.data.specLabel}.{" "}
                <a href={terminologyReference.href}>{terminologyReference.title}</a>
              </>
            ) : (
              <>{feature.data.specLabel}</>
            )}
          </p>
          {(feature.data.capabilityKind === "atomic" || feature.data.support.length > 0) ? <p class="feature-verdict">{supportSnippet}</p> : null}
          <p class="feature-formats">
            <a href={featureMarkdownPath(feature.data.slug)}>Markdown</a>
            {" · "}
            <a href={`/api/v1/features/${feature.data.slug}.json`}>JSON</a>
            {" · "}
            <a href={`/report?targetType=feature&feature=${feature.data.slug}`}>Suggest a correction</a>
          </p>
        </div>
        {(feature.data.capabilityKind === "atomic" || feature.data.support.length > 0) ? <aside class="coverage-stat">
          <span>{feature.data.capabilityKind === "family" ? "Broad product assessments" : "Current product assessments"}</span>
          <strong>{currentSupport.assessed}<small>/{currentSupport.total}</small></strong>
          <dl class="coverage-stat__counts">
            <div data-status="yes"><dt>Supported</dt><dd>{currentSupport.counts.yes}</dd></div>
            <div data-status="partial"><dt>Partial</dt><dd>{currentSupport.counts.partial}</dd></div>
            <div data-status="no"><dt>Unsupported</dt><dd>{currentSupport.counts.no}</dd></div>
          </dl>
          <p>{currentSupport.directEvidence}/{currentSupport.total} have direct reviewed evidence ({formatPercent(currentSupport.total === 0 ? 0 : currentSupport.directEvidence / currentSupport.total)}).</p>
        </aside> : <aside class="coverage-stat">
          <span>Atomic capabilities</span>
          <strong>{graph?.children.length ?? 0}</strong>
          <p>No broad product assessment has been authored for this grouping yet. Child progress remains independent.</p>
        </aside>}
      </div>
      <div class="feature-navigation">
        <nav class="feature-breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/features">Capabilities</a></li>
            {graph?.parent ? <li><a href={`/features/${graph.parent.slug}`}>{graph.parent.title}</a></li> : null}
            <li aria-current="page">{feature.data.title}</li>
          </ol>
        </nav>
        {graph?.parent && graph.siblings.length ? (
          <details class="family-context">
            <summary>
              <span>
                <small>Explore this family</small>
                <strong>More in {graph.parent.title}</strong>
              </span>
              <span class="family-context__count">
                {graph.siblings.length} {graph.siblings.length === 1 ? "capability" : "capabilities"}
              </span>
            </summary>
            <nav aria-label={`Other capabilities in ${graph.parent.title}`}>
              <ul>
                {graph.siblings.map((sibling) => (
                  <li><a href={`/features/${sibling.slug}`}>{sibling.title}</a></li>
                ))}
              </ul>
            </nav>
          </details>
        ) : null}
      </div>
      {(feature.data.capabilityKind === "atomic" || feature.data.support.length > 0) ? <VersionMatrix feature={feature.data} harnesses={harnessData} /> : null}
      {feature.data.capabilityKind === "family" ? (
        <section class="feature-explainer" aria-labelledby="family-progress-title">
          <p class="eyebrow">Product support cells</p>
          <h2 id="family-progress-title">Family progress by product</h2>
          <p>Counts combine {graph?.children.length ?? 0} atomic capabilities. “Reviewed” measures evidence coverage; supported includes yes and partial.</p>
          <div class="table-scroll"><table class="data-table">
            <thead><tr><th>Product</th><th>Supported</th><th>Reviewed</th><th>Breakdown</th></tr></thead>
            <tbody>{familyProgress.map((progress) => {
              const harness = harnessData.find((candidate) => candidate.slug === progress.harness);
              return <tr>
                <th>{harness ? <ProviderMark provider={harness.vendor} productSlug={harness.slug} variant="inline" /> : null}<a href={`/harnesses/${progress.harness}`}>{harness?.title ?? progress.harness}</a><small>{harness?.surface}</small></th>
                <td>{progress.supported}/{progress.total}</td>
                <td>{progress.reviewed}/{progress.total}</td>
                <td>{SUPPORT_STATUS_LABELS.yes} {progress.counts.yes} · {SUPPORT_STATUS_LABELS.partial} {progress.counts.partial} · {SUPPORT_STATUS_LABELS.no} {progress.counts.no} · {SUPPORT_STATUS_LABELS.unknown} {progress.counts.unknown}</td>
              </tr>;
            })}</tbody>
          </table></div>
          <h3>Atomic capabilities</h3>
          <ul>{graph?.children.map((child) => <li><a href={`/features/${child.slug}`}>{child.title}</a> — {child.summary}</li>)}</ul>
        </section>
      ) : null}
      <section class="feature-explainer" aria-labelledby="feature-explainer-title">
        <p class="eyebrow">Definition and scope</p>
        <h2 id="feature-explainer-title">What this capability means</h2>
        <div class="prose-page">
          <Content />
        </div>
      </section>
      {feature.data.capabilityKind === "atomic" ? <AssertionLedger feature={feature.data} harnesses={harnessData} /> : null}
      {feature.data.capabilityKind === "atomic" ? <NotesPanel feature={feature.data} /> : null}
    </main>
  </SiteChrome>
</BaseLayout>
