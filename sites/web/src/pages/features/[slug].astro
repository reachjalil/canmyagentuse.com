---
import {
  breadcrumbJsonLd,
  currentSupportSnapshot,
  expandFeatureSupport,
  featureMarkdownPath,
  featurePath,
  formatPercent,
  resolveMetadata,
  sourcedShare,
  techArticleJsonLd,
} from "@canmyagentuse/catalog";
import { render } from "astro:content";
import NotesPanel from "../../components/NotesPanel.astro";
import AssertionLedger from "../../components/AssertionLedger.astro";
import SiteChrome from "../../components/SiteChrome.astro";
import VersionMatrix from "../../components/VersionMatrix.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entryBySlug, publishedCollection } from "../../lib/collections";
import { currentSupportSnippet } from "../../lib/support";

export async function getStaticPaths() {
  const features = await publishedCollection("features");
  return features.map((feature) => ({
    params: { slug: feature.data.slug },
  }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error("Missing feature slug.");

const features = await publishedCollection("features");
const harnesses = await publishedCollection("harnesses");
const feature = entryBySlug(features, slug);
if (!feature) {
  return Astro.redirect("/404");
}

const { Content } = await render(feature);
const metadata = resolveMetadata(feature.data);
const harnessData = harnesses.map((entry) => entry.data);
const columns = expandFeatureSupport(feature.data, harnessData);
const coverage = sourcedShare(columns);
const currentSupport = currentSupportSnapshot(columns);
const supportSnippet = currentSupportSnippet(feature.data.title, currentSupport);
---

<BaseLayout
  title={metadata.seoTitle}
  description={supportSnippet}
  canonicalPath={metadata.canonicalPath}
  socialTitle={metadata.socialTitle}
  socialDescription={supportSnippet}
  socialImageAlt={metadata.previewImageAlt ?? `${metadata.socialTitle} compatibility card from Can My Agent Use.`}
  contentType="article"
  publishedTime={metadata.published}
  modifiedTime={metadata.updated}
  section={feature.data.category}
  tags={metadata.tags}
  jsonLd={[
    techArticleJsonLd(metadata),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Capabilities", path: "/features" },
      { name: feature.data.title, path: featurePath(feature.data.slug) },
    ]),
  ]}
>
  <SiteChrome searchValue={feature.data.title}>
    <main id="main" class="shell feature-page">
      <div class="feature-head">
        <div class="feature-head__copy">
          <p class="font-mono text-xs text-[color:var(--color-muted)]">
            Capability · {feature.data.category}
          </p>
          <h1 class="mt-2 text-4xl font-semibold tracking-tight">
            {feature.data.title}
            {
              feature.data.specification ? (
                <a class="spec-pill" href={`/specs/${feature.data.specification.id}`}>
                  {feature.data.specLabel}
                </a>
              ) : (
                <span class="spec-pill">{feature.data.specLabel}</span>
              )
            }
          </h1>
          <p class="mt-4 max-w-2xl text-lg text-[color:var(--color-muted)]">
            {feature.data.summary}
          </p>
          <p class="feature-verdict">{supportSnippet}</p>
          <p class="feature-formats">
            <a href={featureMarkdownPath(feature.data.slug)}>Markdown</a>
            {" · "}
            <a href={`/api/v1/features/${feature.data.slug}.json`}>JSON</a>
          </p>
        </div>
        <aside class="coverage-stat">
          <span>Current products reviewed</span>
          <strong>{currentSupport.sourced}<small>/{currentSupport.total}</small></strong>
          <dl class="coverage-stat__counts">
            <div data-status="yes"><dt>Supported</dt><dd>{currentSupport.counts.yes}</dd></div>
            <div data-status="partial"><dt>Partial</dt><dd>{currentSupport.counts.partial}</dd></div>
            <div data-status="no"><dt>Unsupported</dt><dd>{currentSupport.counts.no}</dd></div>
          </dl>
          <p>{formatPercent(coverage)} of all current and preview tracks are sourced.</p>
        </aside>
      </div>
      <VersionMatrix feature={feature.data} harnesses={harnessData} />
      <section class="feature-explainer" aria-labelledby="feature-explainer-title">
        <p class="eyebrow">Definition and scope</p>
        <h2 id="feature-explainer-title">What this capability means</h2>
        <div class="prose-page">
          <Content />
        </div>
      </section>
      <AssertionLedger feature={feature.data} harnesses={harnessData} />
      <NotesPanel feature={feature.data} />
    </main>
  </SiteChrome>
</BaseLayout>
