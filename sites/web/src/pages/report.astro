---
import { SITE, websiteJsonLd } from "@canmyagentuse/catalog";
import SiteChrome from "../components/SiteChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publishedCollection } from "../lib/collections";

const features = await publishedCollection("features");
const harnesses = await publishedCollection("harnesses");
---

<BaseLayout
  title={`Suggest a correction | ${SITE.name}`}
  description="Submit a structured, evidence-aware catalog correction for editorial review and receive a trackable receipt."
  canonicalPath="/report"
  jsonLd={[websiteJsonLd()]}
>
  <SiteChrome>
    <main id="main" class="shell py-8">
      <p class="eyebrow">Catalog correction</p>
      <h1 class="text-4xl font-semibold tracking-tight">Suggest a correction</h1>
      <p class="report-lede">
        Propose one bounded change. The queue records the current catalog snapshot,
        your proposed status and sources, material conditions, and any declared
        affiliation. Submissions never update the catalog automatically.
      </p>

      <div class="report-layout mt-8">
        <form class="report-form" data-correction-form>
          <input name="startedAt" type="hidden" />
          <input name="submittedStatus" type="hidden" />
          <input name="submittedAssessment" type="hidden" />
          <input name="submittedSources" type="hidden" />
          <input name="catalogPermalink" type="hidden" />
          <label class="honeypot" aria-hidden="true">
            Website
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>

          <div class="report-form__row">
            <label>
              Correction target
              <select name="targetType" required>
                <option value="cell">Exact compatibility cell</option>
                <option value="feature">Capability definition or page</option>
                <option value="harness">Product identity or page</option>
                <option value="evidence">Evidence or source record</option>
                <option value="methodology">Methodology</option>
                <option value="missing-harness">Missing product</option>
                <option value="missing-feature">Missing capability</option>
                <option value="general">Other catalog issue</option>
              </select>
            </label>
            <label>
              Proposed status
              <select name="proposedStatus" required>
                <option value="yes">Supported</option>
                <option value="partial">Partial</option>
                <option value="no">Unsupported</option>
                <option value="unknown">Unknown</option>
                <option value="na">Not applicable</option>
              </select>
            </label>
          </div>

          <div class="report-form__row">
            <label>
              Capability
              <select name="feature">
                <option value="">Choose when applicable</option>
                {features.map((feature) => (
                  <option value={feature.data.slug}>{feature.data.title}</option>
                ))}
              </select>
            </label>
            <label>
              Product and exact surface
              <select name="harness">
                <option value="">Choose when applicable</option>
                {harnesses.map((harness) => (
                  <option value={harness.data.slug} data-surface={harness.data.surface}>
                    {harness.data.title} ({harness.data.surface})
                  </option>
                ))}
              </select>
            </label>
          </div>

          <div class="report-form__row report-form__row--three">
            <label>
              Track
              <select name="track">
                <option value="current">Current</option>
                <option value="preview">Preview</option>
              </select>
            </label>
            <label>
              Date observed
              <input name="observedAt" type="date" />
            </label>
            <label>
              Product version
              <input name="version" maxlength="160" placeholder="Version or dated release" />
            </label>
          </div>

          <label>
            Explanation
            <textarea
              name="explanation"
              rows="6"
              minlength="20"
              maxlength="6000"
              required
              placeholder="Explain the smallest status or catalog change you propose and why. Distinguish a product limitation from an evidence gap."
            ></textarea>
          </label>

          <label>
            Public source URLs <span>Up to five HTTPS links, one per line</span>
            <textarea
              name="sourceUrls"
              rows="4"
              placeholder="https://docs.example.com/exact-page"
            ></textarea>
          </label>

          <label>
            Reproduction steps <span>Optional</span>
            <textarea
              name="reproductionSteps"
              rows="5"
              maxlength="6000"
              placeholder="Give a minimal, safe reproduction. Do not include tokens, private screenshots, customer data, or private beta material."
            ></textarea>
          </label>

          <div class="report-form__row report-form__row--four">
            <label>Plan <input name="plan" maxlength="160" placeholder="Free, Pro, Enterprise…" /></label>
            <label>Platform <input name="platform" maxlength="160" placeholder="macOS, Windows, web…" /></label>
            <label>Surface <input name="surface" maxlength="160" placeholder="Chat, Cowork, CLI…" /></label>
            <label>
              Affiliation
              <select name="affiliation">
                <option value="none">No affiliation</option>
                <option value="provider-employee">Provider employee</option>
                <option value="provider-contractor">Provider contractor</option>
                <option value="provider-partner">Provider partner</option>
                <option value="customer">Customer</option>
                <option value="researcher">Researcher</option>
                <option value="other">Other</option>
              </select>
            </label>
          </div>

          <label>
            Affiliation details <span>Optional</span>
            <input name="affiliationDetails" maxlength="500" />
          </label>

          <div class="report-form__row">
            <label>
              Contact email <span>Optional and never published</span>
              <input name="contact" type="email" maxlength="254" autocomplete="email" />
            </label>
            <label class="report-form__checkbox">
              <input name="permissionToContact" type="checkbox" />
              The editorial team may contact me about this correction.
            </label>
          </div>

          <label>
            How may we use your explanation?
            <select name="publicationPreference">
              <option value="internal-only">Editorial review only — do not publish my wording</option>
              <option value="may-publish">The explanation may be quoted in public editorial history</option>
            </select>
          </label>

          <div class="report-form__notice">
            The server sanitizes text, validates source URLs, limits submission size
            and frequency, hashes network identifiers for abuse controls, and
            records a moderation event. Contact details remain private. Your
            explanation stays internal unless you explicitly allow publication.
            Accepted changes receive a public editorial history; every valid
            submission receives a CMAU receipt.
          </div>

          <button class="report-form__submit" type="submit" data-submit-correction>
            Submit for editorial review
          </button>
          <p class="report-form__status" data-form-status aria-live="polite"></p>
        </form>

        <aside class="report-guide">
          <h2>Review workflow</h2>
          <ol>
            <li><span>01</span><p>Received — the queue stores the proposal and current catalog snapshot.</p></li>
            <li><span>02</span><p>Triaged — an editor checks scope, sources, affiliation, duplication, and spam signals.</p></li>
            <li><span>03</span><p>The editor may request more information or decide the proposal.</p></li>
            <li><span>04</span><p>Accepted changes are implemented through normal evidence review, validation, and deployment.</p></li>
          </ol>
          <p>
            Review states are received, triaged, needs more information,
            accepted, partially accepted, declined, duplicate, or superseded.
          </p>
          <p class="mt-4">
            Read the <a href="/methodology">status and assessment rules</a>.
          </p>
        </aside>
      </div>

      <section class="receipt mt-8" data-receipt hidden aria-live="polite">
        <p class="eyebrow">Correction received</p>
        <h2 data-receipt-id></h2>
        <p data-receipt-message></p>
        <a data-receipt-link href="#">Open receipt and editorial history</a>
      </section>
    </main>
  </SiteChrome>
</BaseLayout>

<script>
  const form = document.querySelector("[data-correction-form]");
  const status = document.querySelector("[data-form-status]");
  const submit = document.querySelector("[data-submit-correction]");
  const receipt = document.querySelector("[data-receipt]");
  const receiptId = receipt?.querySelector("[data-receipt-id]");
  const receiptMessage = receipt?.querySelector("[data-receipt-message]");
  const receiptLink = receipt?.querySelector("[data-receipt-link]");
  const params = new URLSearchParams(window.location.search);

  const setField = (name: string, value: string | null) => {
    if (!value || !(form instanceof HTMLFormElement)) return;
    const field = form.elements.namedItem(name);
    if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
      field.value = value;
    } else if (field instanceof HTMLSelectElement) {
      if ([...field.options].some((option) => option.value === value)) field.value = value;
    }
  };

  setField("startedAt", new Date().toISOString());
  setField("observedAt", new Date().toISOString().slice(0, 10));
  for (const name of ["targetType", "feature", "harness", "track", "proposedStatus"]) {
    setField(name, params.get(name));
  }
  setField("submittedStatus", params.get("status"));
  setField("submittedAssessment", params.get("assessment"));
  setField("submittedSources", params.get("sources"));
  setField("catalogPermalink", params.get("permalink"));
  setField("observedAt", params.get("assessedAt"));
  setField("surface", params.get("surface"));

  const harnessField = form instanceof HTMLFormElement
    ? form.elements.namedItem("harness")
    : null;
  const syncSurface = () => {
    if (!(harnessField instanceof HTMLSelectElement)) return;
    const selected = harnessField.selectedOptions[0];
    setField("surface", selected?.dataset.surface ?? null);
  };
  if (harnessField instanceof HTMLSelectElement) {
    harnessField.addEventListener("change", syncSurface);
    if (!params.get("surface")) syncSurface();
  }

  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(submit instanceof HTMLButtonElement)) return;
      submit.disabled = true;
      if (status) status.textContent = "Submitting securely…";
      if (receipt instanceof HTMLElement) receipt.hidden = true;
      const data = new FormData(form);
      const payload: Record<string, unknown> = Object.fromEntries(data.entries());
      payload.permissionToContact = data.has("permissionToContact");
      try {
        const response = await fetch("/api/v1/corrections", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = (await response.json()) as {
          id?: string;
          message?: string;
          statusUrl?: string;
          error?: string;
          details?: string[];
        };
        if (!response.ok) {
          const details = Array.isArray(result.details) ? ` ${result.details.join(" ")}` : "";
          throw new Error(`${result.error ?? "The correction was not accepted."}${details}`);
        }
        if (status) status.textContent = "Submission recorded.";
        if (receiptId) receiptId.textContent = result.id ?? "Correction received";
        if (receiptMessage) receiptMessage.textContent = result.message ?? "Queued for review.";
        if (receiptLink instanceof HTMLAnchorElement) receiptLink.href = result.statusUrl ?? "/report";
        if (receipt instanceof HTMLElement) {
          receipt.hidden = false;
          receipt.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      } catch (error) {
        if (status) {
          status.textContent =
            error instanceof Error ? error.message : "The correction could not be submitted.";
        }
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .report-lede {
    max-width: 52rem;
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }
  .report-layout { display: grid; gap: 1rem; align-items: start; }
  .report-form, .report-guide, .receipt {
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    padding: 1rem;
  }
  .report-form { display: grid; gap: 0.9rem; }
  .report-form__row { display: grid; gap: 0.9rem; }
  .report-form label {
    display: grid;
    gap: 0.3rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }
  .report-form label span { font-size: 0.58rem; text-transform: none; }
  .report-form :where(input, select, textarea) {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 0;
    background: var(--color-canvas);
    color: var(--color-ink);
    padding: 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.45;
    text-transform: none;
  }
  .report-form :where(input, select) { min-height: 2.7rem; }
  .report-form textarea { resize: vertical; }
  .report-form__checkbox {
    grid-template-columns: auto 1fr !important;
    align-content: center;
    align-items: center;
    text-transform: none !important;
  }
  .report-form__checkbox input { width: 1.1rem; min-height: 1.1rem; }
  .honeypot { position: absolute !important; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .report-form__notice {
    border-left: 0.25rem solid var(--color-partial);
    background: color-mix(in srgb, var(--color-paper) 75%, var(--color-partial));
    padding: 0.75rem;
    color: var(--color-muted);
    font-size: 0.76rem;
  }
  .report-form__submit {
    display: inline-flex;
    min-height: 2.7rem;
    align-items: center;
    justify-content: center;
    justify-self: start;
    border: 1px solid var(--color-ink);
    border-radius: 0;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 0.55rem 0.8rem;
    cursor: pointer;
    font-weight: 500;
  }
  .report-form__submit:disabled { cursor: wait; opacity: 0.6; }
  .report-form__status { min-height: 1.2rem; margin: 0; color: var(--color-muted); font-size: 0.8rem; }
  .report-guide h2, .receipt h2 { margin: 0; font-size: 1.2rem; }
  .report-guide ol { display: grid; gap: 0.7rem; margin: 1rem 0; padding: 0; list-style: none; }
  .report-guide li {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.55rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.6rem;
  }
  .report-guide li span { color: var(--color-copper-deep); font-family: var(--font-mono); font-size: 0.72rem; }
  .report-guide p { margin: 0; color: var(--color-muted); font-size: 0.8rem; line-height: 1.5; }
  .receipt[hidden] { display: none; }
  .receipt h2 { margin-top: 0.4rem; font-family: var(--font-mono); font-size: 1.8rem; }
  @media (min-width: 760px) {
    .report-layout { grid-template-columns: minmax(0, 1fr) 19rem; }
    .report-form__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .report-form__row--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .report-form__row--four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
