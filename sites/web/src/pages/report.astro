---
import { SITE, websiteJsonLd } from "@canmyagentuse/catalog";
import SiteChrome from "../components/SiteChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publishedCollection } from "../lib/collections";

const features = await publishedCollection("features");
const harnesses = await publishedCollection("harnesses");
const issueTracker = import.meta.env.PUBLIC_ISSUE_TRACKER_URL?.trim() ?? "";
---

<BaseLayout
  title={`Report an issue | ${SITE.name}`}
  description="Prepare a structured report about an incorrect, incomplete, or stale compatibility result."
  canonicalPath="/report"
  jsonLd={[websiteJsonLd()]}
>
  <SiteChrome>
    <main id="main" class="shell py-8">
      <p class="eyebrow">Catalog correction</p>
      <h1 class="text-4xl font-semibold tracking-tight">Report an issue</h1>
      <p class="report-lede">
        Describe one result for one capability and one exact product. Public reports start a
        review. They do not change a support state without evidence.
      </p>

      <div class="report-layout mt-8" data-report-builder data-issue-tracker={issueTracker}>
        <form class="report-form" data-report-form>
          <div class="report-form__row">
            <label>
              Capability
              <select name="feature" required>
                <option value="">Choose a capability</option>
                {features.map((feature) => <option value={feature.data.slug}>{feature.data.title}</option>)}
              </select>
            </label>
            <label>
              Product
              <select name="harness" required>
                <option value="">Choose a product</option>
                {harnesses.map((harness) => (
                  <option value={harness.data.slug}>
                    {harness.data.title} ({harness.data.surface})
                  </option>
                ))}
              </select>
            </label>
          </div>

          <div class="report-form__row report-form__row--three">
            <label>
              Record
              <select name="track" required>
                <option value="current">Current</option>
                <option value="preview">Preview</option>
              </select>
            </label>
            <label>
              Report type
              <select name="kind" required>
                <option value="Incorrect status">Incorrect status</option>
                <option value="Missing condition">Missing condition</option>
                <option value="Known product issue">Known product issue</option>
                <option value="Stale source">Stale source</option>
                <option value="Other correction">Other correction</option>
              </select>
            </label>
            <label>
              Date observed
              <input name="observedAt" type="date" required />
            </label>
          </div>

          <label>
            What did you observe?
            <textarea
              name="observed"
              rows="5"
              required
              placeholder="State the behavior, error, missing control, or limit. Include the plan, platform, region, policy, and setup when they matter."
            ></textarea>
          </label>

          <label>
            What should the catalog say?
            <textarea
              name="expected"
              rows="4"
              required
              placeholder="Describe the smallest correction you think is needed."
            ></textarea>
          </label>

          <label>
            Public evidence URL <span>Optional</span>
            <input
              name="evidenceUrl"
              type="url"
              inputmode="url"
              placeholder="https://docs.example.com/..."
            />
          </label>

          <div class="report-form__notice">
            Do not include account details, private screenshots, tokens, customer data, or private
            beta material. Use a public source when one exists.
          </div>

          <button class="report-form__submit" type="submit">Build report</button>
        </form>

        <aside class="report-guide">
          <h2>What happens next</h2>
          <ol>
            <li><span>01</span><p>The builder creates a reviewable Markdown report.</p></li>
            <li><span>02</span><p>Open the public issue tracker when it is configured, or copy the draft.</p></li>
            <li><span>03</span><p>A maintainer checks the exact product, conditions, and source.</p></li>
            <li><span>04</span><p>The catalog changes only after the evidence is reviewed.</p></li>
          </ol>
          <p>
            Read the <a href="/methodology">status and evidence rules</a> before reporting a broad
            product claim.
          </p>
        </aside>
      </div>

      <section class="report-output mt-8" data-report-output hidden aria-live="polite">
        <div>
          <p class="eyebrow">Review before sharing</p>
          <h2>Issue report draft</h2>
          <p data-tracker-state></p>
        </div>
        <textarea rows="18" readonly data-report-draft aria-label="Generated issue report"></textarea>
        <div class="report-output__actions">
          <button type="button" data-copy-report>Copy report</button>
          <button type="button" data-download-report>Download Markdown</button>
          <a href="#" target="_blank" rel="noreferrer" data-open-tracker hidden>Open issue tracker</a>
        </div>
        <p class="report-output__status" data-copy-status></p>
      </section>
    </main>
  </SiteChrome>
</BaseLayout>

<script>
  const root = document.querySelector("[data-report-builder]");
  const form = root?.querySelector("[data-report-form]");
  const output = document.querySelector("[data-report-output]");
  const draft = output?.querySelector("[data-report-draft]");
  const trackerLink = output?.querySelector("[data-open-tracker]");
  const trackerState = output?.querySelector("[data-tracker-state]");
  const copyStatus = output?.querySelector("[data-copy-status]");
  const trackerBase = root?.getAttribute("data-issue-tracker") ?? "";
  const params = new URLSearchParams(window.location.search);

  const setSelect = (name: string) => {
    const value = params.get(name);
    const select = form?.querySelector(`[name="${name}"]`);
    if (value && select instanceof HTMLSelectElement) select.value = value;
  };

  setSelect("feature");
  setSelect("harness");
  setSelect("track");

  const optionText = (data: FormData, name: string) => {
    const select = form?.querySelector(`[name="${name}"]`);
    if (!(select instanceof HTMLSelectElement)) return String(data.get(name) ?? "");
    return select.selectedOptions[0]?.textContent?.trim() ?? String(data.get(name) ?? "");
  };

  const makeDraft = (data: FormData) => {
    const capability = optionText(data, "feature");
    const product = optionText(data, "harness");
    const featureSlug = String(data.get("feature") ?? "");
    const evidenceUrl = String(data.get("evidenceUrl") ?? "").trim();
    const lines = [
      `# ${String(data.get("kind") ?? "Correction")}: ${capability} on ${product}`,
      "",
      `- Capability: ${capability}`,
      `- Product: ${product}`,
      `- Catalog record: ${String(data.get("track") ?? "current")}`,
      `- Date observed: ${String(data.get("observedAt") ?? "")}`,
      `- Catalog page: https://canmyagentuse.com/features/${featureSlug}`,
      evidenceUrl ? `- Public evidence: ${evidenceUrl}` : "- Public evidence: Not provided",
      "",
      "## Observed behavior",
      "",
      String(data.get("observed") ?? "").trim(),
      "",
      "## Suggested correction",
      "",
      String(data.get("expected") ?? "").trim(),
      "",
      "## Reporter check",
      "",
      "- [ ] This report does not contain private account or customer data.",
      "- [ ] I named one exact product and capability.",
      "- [ ] I included material plan, platform, policy, region, and setup conditions.",
    ];
    return lines.join("\n");
  };

  if (form instanceof HTMLFormElement && output instanceof HTMLElement && draft instanceof HTMLTextAreaElement) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const report = makeDraft(data);
      const title = `${String(data.get("kind") ?? "Correction")}: ${optionText(data, "feature")} on ${optionText(data, "harness")}`;
      draft.value = report;
      output.hidden = false;

      if (trackerBase && trackerLink instanceof HTMLAnchorElement) {
        try {
          const trackerUrl = new URL(trackerBase);
          trackerUrl.searchParams.set("title", title);
          trackerUrl.searchParams.set("body", report);
          trackerLink.href = trackerUrl.toString();
          trackerLink.hidden = false;
          if (trackerState) trackerState.textContent = "Review the draft, then open the public issue tracker.";
        } catch {
          trackerLink.hidden = true;
          if (trackerState) trackerState.textContent = "The issue tracker address is invalid. Copy or download the draft.";
        }
      } else {
        if (trackerLink instanceof HTMLAnchorElement) trackerLink.hidden = true;
        if (trackerState) trackerState.textContent = "No public issue tracker is configured yet. Copy or download the draft.";
      }

      output.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  output?.querySelector("[data-copy-report]")?.addEventListener("click", async () => {
    if (!(draft instanceof HTMLTextAreaElement)) return;
    try {
      await navigator.clipboard.writeText(draft.value);
      if (copyStatus) copyStatus.textContent = "Report copied.";
    } catch {
      draft.focus();
      draft.select();
      if (copyStatus) copyStatus.textContent = "Copy is blocked in this browser. The report text is selected.";
    }
  });

  output?.querySelector("[data-download-report]")?.addEventListener("click", () => {
    if (!(draft instanceof HTMLTextAreaElement)) return;
    const blob = new Blob([draft.value], { type: "text/markdown;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = "canmyagentuse-issue-report.md";
    anchor.click();
    URL.revokeObjectURL(url);
  });
</script>

<style>
  .report-lede {
    max-width: 46rem;
    margin: 0.8rem 0 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .report-layout {
    display: grid;
    gap: 1rem;
    align-items: start;
  }

  .report-form,
  .report-guide,
  .report-output {
    border: 1px solid var(--color-line);
    background: var(--color-paper);
    padding: 1rem;
  }

  .report-form {
    display: grid;
    gap: 0.9rem;
  }

  .report-form__row {
    display: grid;
    gap: 0.9rem;
  }

  .report-form label {
    display: grid;
    gap: 0.3rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .report-form label span {
    font-size: 0.58rem;
    text-transform: none;
  }

  .report-form :where(input, select, textarea),
  .report-output textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 0;
    background: var(--color-canvas);
    color: var(--color-ink);
    padding: 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.45;
    text-transform: none;
  }

  .report-form :where(input, select) { min-height: 2.7rem; }
  .report-form textarea { resize: vertical; }

  .report-form__notice {
    border-left: 0.25rem solid var(--color-partial);
    background: color-mix(in srgb, var(--color-paper) 75%, var(--color-partial));
    padding: 0.75rem;
    color: var(--color-muted);
    font-size: 0.76rem;
  }

  .report-form__submit,
  .report-output__actions :where(button, a) {
    display: inline-flex;
    min-height: 2.7rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-ink);
    border-radius: 0;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 0.55rem 0.8rem;
    cursor: pointer;
    font-weight: 500;
    text-decoration: none;
  }

  .report-form__submit { justify-self: start; }

  .report-guide h2,
  .report-output h2 {
    margin: 0;
    font-size: 1.2rem;
  }

  .report-guide ol {
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0;
    padding: 0;
    list-style: none;
  }

  .report-guide li {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.55rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.6rem;
  }

  .report-guide li span {
    color: var(--color-copper-deep);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .report-guide p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .report-output[hidden] { display: none; }
  .report-output > div:first-child p:last-child { color: var(--color-muted); }
  .report-output textarea { margin-top: 1rem; font-family: var(--font-mono); font-size: 0.74rem; }

  .report-output__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .report-output__actions button:nth-child(2) {
    background: transparent;
    color: var(--color-ink);
  }

  .report-output__status {
    min-height: 1.2rem;
    margin: 0.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  @media (min-width: 760px) {
    .report-layout { grid-template-columns: minmax(0, 1fr) 18rem; }
    .report-form__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .report-form__row--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
