---
import { REVIEW_VERDICTS, SITE, websiteJsonLd } from "@canmyagentuse/catalog";
import SiteChrome from "../../components/SiteChrome.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publishedCollection } from "../../lib/collections";

const news = await publishedCollection("news");
---

<BaseLayout
  title={`Field Notes | ${SITE.name}`}
  description="Everyday requests, real-world agent access. Explore our living reviews, verdicts, and latest findings."
  canonicalPath="/news"
  jsonLd={[websiteJsonLd()]}
>
  <SiteChrome>
    <main id="main" class="shell py-8">
      <h1 class="text-4xl font-semibold tracking-tight">Field Notes</h1>
      <p class="mt-3 max-w-2xl text-[color:var(--color-muted)]">
        Can your agent actually do it? Follow the exploration, read the verdict, and come back as the answer evolves.
      </p>
      <ul class="mt-8 space-y-4">
        {
          news.map((item) => (
            <li class="border border-[color:var(--color-line)] bg-[color:var(--color-paper)] p-5">
              <p class="font-mono text-xs text-[color:var(--color-muted)]">
                {item.data.published?.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </p>
              <a class="text-2xl font-semibold tracking-tight" href={`/news/${item.data.slug}`}>
                {item.data.title}
              </a>
              <p class="mt-2 text-[color:var(--color-muted)]">{item.data.summary}</p>
              {item.data.review && <p class="mt-3 font-mono text-xs text-[color:var(--color-copper-deep)]">◇ {REVIEW_VERDICTS[item.data.review.verdict]} · Version {item.data.review.version} · Updated {item.data.review.reviewedAt}</p>}
            </li>
          ))
        }
      </ul>
      <section class="mt-12 border-t border-[color:var(--color-line)] pt-6">
        <p class="font-mono text-xs text-[color:var(--color-copper-deep)]">QUESTIONS WE’RE EXPLORING</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight">Same question. A different part of your day.</h2>
        <p class="mt-3 max-w-2xl text-[color:var(--color-muted)]">Which notes app should your agent use? Can it launch a website, buy a laptop, or organize your inbox? Each deserves its own exploration. These are research leads; verdicts follow the evidence.</p>
        <a class="mt-4 inline-block underline" href="/submit-app">Have a service we should investigate? Submit your app ↗</a>
      </section>
    </main>
  </SiteChrome>
</BaseLayout>
