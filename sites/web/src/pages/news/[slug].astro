---
import {
  breadcrumbJsonLd,
  newsPath,
  resolveMetadata,
  techArticleJsonLd,
} from "@canmyagentuse/catalog";
import { render } from "astro:content";
import ReviewVerdict from "../../components/ReviewVerdict.astro";
import SiteChrome from "../../components/SiteChrome.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entryBySlug, publishedCollection } from "../../lib/collections";

export async function getStaticPaths() {
  const news = await publishedCollection("news");
  return news.map((item) => ({
    params: { slug: item.data.slug },
  }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error("Missing news slug.");

const news = await publishedCollection("news");
const item = entryBySlug(news, slug);
if (!item) {
  return Astro.redirect("/404");
}

const { Content } = await render(item);
const metadata = resolveMetadata(item.data);
const review = item.data.review;
const isExplainer = Boolean(review);
const isAppUsage = Boolean(review) || item.data.tags.includes("app-usage");
---

<BaseLayout
  title={metadata.seoTitle}
  description={metadata.description}
  canonicalPath={metadata.canonicalPath}
  socialTitle={metadata.socialTitle}
  socialDescription={metadata.socialDescription}
  socialImageAlt={metadata.previewImageAlt ?? `${metadata.socialTitle} catalog news card from Can My Agent Use.`}
  contentType="article"
  publishedTime={metadata.published}
  modifiedTime={metadata.updated}
  section="App usage"
  tags={metadata.tags}
  jsonLd={[
    techArticleJsonLd(metadata),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "App usage", path: "/news" },
      { name: item.data.title, path: newsPath(item.data.slug) },
    ]),
  ]}
>
  <SiteChrome>
    <main id="main" class:list={["shell py-8", { explainer: isExplainer }]}>
      <header class="article-intro">
        <p class="article-kicker">{review ? `APP USAGE / ${String(review.number).padStart(2, "0")} · A LIVING REVIEW` : isAppUsage ? "App usage guide" : "Catalog development archive"}</p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight">{item.data.title}</h1>
        <p class="article-deck">{item.data.summary}</p>
        {review && (
          <div class="article-meta">
            <span>Updated {review.reviewedAt} · Version {review.version}</span>
            <span>One question. An evolving answer.</span>
            <a href="#verdict-heading">Read the verdict ↓</a>
          </div>
        )}
      </header>
      {review && <ReviewVerdict review={review} />}
      {!isAppUsage && <p class="mt-6 border-l-2 border-[color:var(--color-line)] pl-4 text-[color:var(--color-muted)]">This is an archived catalog announcement. Figures reflect its publication date. See <a class="underline" href="/coverage">current coverage</a> or browse the <a class="underline" href="/news">app usage guides</a>.</p>}
      <div class="prose-page mt-8">
        <Content />
        {review && (
          <section id="review-history" class="review-history" aria-labelledby="history-heading">
            <h2 id="history-heading">This exploration keeps going</h2>
            <p>We revisit this question as services change and new evidence arrives. This URL always holds the latest edition; earlier editions and the reasons for each update are recorded below.</p>
            <details>
              <summary>Update history · {review.history.length} editions</summary>
              <ol>
                {[...review.history].reverse().map((entry) => (
                  <li>
                    <strong>Version {entry.version} · {entry.date}</strong>
                    <p>{entry.change}</p>
                    {entry.archiveUrl && <a href={entry.archiveUrl}>Read this edition ↗</a>}
                  </li>
                ))}
              </ol>
            </details>
            <p>Have a source or result that could change the verdict? <a href="/submit-app">Send it for review</a>. Evidence changes the answer; sponsorship never does.</p>
          </section>
        )}
      </div>
    </main>
  </SiteChrome>
</BaseLayout>


<style>
  .article-kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-copper-deep);
  }
  .article-deck {
    max-width: 42rem;
    margin-top: 1.25rem;
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .explainer { max-width: 72rem; padding-top: 3rem; }
  .explainer .article-intro {
    padding: clamp(1.4rem, 4vw, 3.5rem);
    border: 1px solid var(--color-line);
    border-top: 4px solid var(--color-copper);
    background: var(--color-paper);
    position: relative;
  }
  .explainer h1 {
    max-width: 16ch;
    margin-top: 1.5rem;
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-muted);
  }
  .article-meta a { color: var(--color-copper-deep); text-decoration: underline; }
  .explainer .prose-page { max-width: 48rem; margin: 3rem auto; }
  .explainer :global(.prose-page > blockquote:first-child) {
    padding: clamp(1.4rem, 4vw, 2.3rem);
    border: 1px dashed var(--color-copper-deep);
    border-radius: 1rem;
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: 500;
    line-height: 1.5;
    background: var(--color-paper);
  }
  .explainer :global(.prose-page > blockquote:first-child p) { line-height: inherit; }
  .explainer :global(.prose-page h2) { scroll-margin-top: 6rem; text-wrap: balance; }
  .review-history { scroll-margin-top: 6rem; }
  .review-history summary { cursor: pointer; font-weight: 600; }
  .review-history li { padding: 0.75rem 0; }
  @media (max-width: 600px) {
    .explainer { padding-top: 1.25rem; }
    .explainer .prose-page { margin-top: 2rem; }
  }
</style>
