---
import {
  HARNESS_SURFACE_LABELS,
  SITE,
  buildCoverageReport,
  formatPercent,
  websiteJsonLd,
} from "@canmyagentuse/catalog";
import SiteChrome from "../components/SiteChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publishedCollection } from "../lib/collections";

const [features, harnesses] = await Promise.all([
  publishedCollection("features"),
  publishedCollection("harnesses"),
]);
const report = buildCoverageReport(
  features.map((entry) => entry.data),
  harnesses.map((entry) => entry.data)
);
const featureRows = report.features.toSorted(
  (left, right) =>
    right.unknown - left.unknown || left.title.localeCompare(right.title)
);
const harnessRows = report.harnesses.toSorted(
  (left, right) =>
    right.sourced - left.sourced || left.title.localeCompare(right.title)
);
---

<BaseLayout
  title={`Catalog coverage | ${SITE.name}`}
  description="Current catalog completeness by product type, capability, and exact product column. Coverage is not a product score."
  canonicalPath="/coverage"
  jsonLd={[websiteJsonLd()]}
>
  <SiteChrome>
    <main id="main" class="shell py-8">
      <p class="eyebrow">Catalog completeness</p>
      <h1 class="text-4xl font-semibold tracking-tight">Catalog coverage</h1>
      <p class="mt-3 max-w-3xl text-lg text-[color:var(--color-muted)]">
        {report.totals.assessed} of {report.totals.total} current-track cells have a
        responsible public status assessment; {report.totals.directEvidence} have
        direct reviewed evidence. These are research-completeness measures, not
        rankings of product quality, popularity, or conformance.
      </p>
      <div class="trust-banner mt-6">
        <strong>Unknown is a deliberate result.</strong> It means this catalog
        has not yet published a sufficiently scoped, dated source for that
        capability and exact surface. It does not mean unsupported.
      </div>

      <section class="coverage-overview mt-8" aria-labelledby="coverage-overview-title">
        <div class="coverage-dials">
          <div class="coverage-dial">
            <span id="coverage-overview-title">Assessed status share</span>
            <strong>{formatPercent(report.totals.assessedShare)}</strong>
            <small>{report.totals.unknown} unknown cells remain</small>
          </div>
          <div class="coverage-dial coverage-dial--secondary">
            <span>Compatible among assessed</span>
            <strong>{formatPercent(report.totals.compatibleShareOfAssessed)}</strong>
            <small>{report.totals.compatible} supported or partial assessments</small>
          </div>
          <div class="coverage-dial coverage-dial--secondary">
            <span>Direct reviewed evidence</span>
            <strong>{formatPercent(report.totals.directEvidenceShare)}</strong>
            <small>{report.totals.directEvidence} documentation, test, attestation, or listing contracts</small>
          </div>
        </div>
        <div class="coverage-surface-grid">
          {report.surfaces.map((surface) => (
            <article>
              <header><strong>{HARNESS_SURFACE_LABELS[surface.surface]}</strong><span>{surface.harnesses} surfaces</span></header>
              <div class="coverage-meter" aria-label={`${surface.assessed} of ${surface.total} current-track cells assessed`}>
                <span style={`width:${surface.assessedShare * 100}%`} />
              </div>
              <p><b>{surface.assessed}</b> assessed · {surface.directEvidence} direct evidence · {surface.unknown} unknown</p>
            </article>
          ))}
        </div>
      </section>

      <section class="mt-10" aria-labelledby="coverage-capability-title">
        <div class="section-heading">
          <div><p class="eyebrow">Most unknown first</p><h2 id="coverage-capability-title">By capability</h2></div>
          <p>Capabilities with the most unknown product cells appear first.</p>
        </div>
        <div class="table-scroll">
          <table class="data-table coverage-table">
            <thead><tr><th>Capability</th><th>Assessed</th><th>Compatible among assessed</th><th>Direct evidence</th><th>Unknown</th></tr></thead>
            <tbody>
              {featureRows.map((row) => (
                <tr>
                  <td><a href={`/features/${row.slug}`}>{row.title}</a></td>
                  <td>{row.assessed} / {row.total} ({formatPercent(row.assessedShare)})</td>
                  <td>{row.compatible} / {row.assessed - row.notApplicable} ({formatPercent(row.compatibleShareOfAssessed)})</td>
                  <td><span class="mini-meter"><i style={`width:${row.directEvidenceShare * 100}%`} /></span><small>{row.directEvidence} · {formatPercent(row.directEvidenceShare)}</small></td>
                  <td>{row.unknown}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-10" aria-labelledby="coverage-harness-title">
        <div class="section-heading">
          <div><p class="eyebrow">Exact columns</p><h2 id="coverage-harness-title">By product</h2></div>
          <p><a href="/api/v1/coverage.json">Download the coverage report as JSON</a></p>
        </div>
        <div class="table-scroll">
          <table class="data-table coverage-table">
            <thead><tr><th>Product column</th><th>Type</th><th>Assessed</th><th>Compatible among assessed</th><th>Direct evidence</th><th>Unknown</th></tr></thead>
            <tbody>
              {harnessRows.map((row) => (
                <tr>
                  <td><a href={`/harnesses/${row.slug}`}>{row.title}</a></td>
                  <td>{HARNESS_SURFACE_LABELS[row.surface]}</td>
                  <td>{row.assessed} / {row.total} ({formatPercent(row.assessedShare)})</td>
                  <td>{row.compatible} / {row.assessed - row.notApplicable} ({formatPercent(row.compatibleShareOfAssessed)})</td>
                  <td><span class="mini-meter"><i style={`width:${row.directEvidenceShare * 100}%`} /></span><small>{row.directEvidence} · {formatPercent(row.directEvidenceShare)}</small></td>
                  <td>{row.unknown}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </SiteChrome>
</BaseLayout>

<style>
  .coverage-dials { display: grid; gap: 0.55rem; }
  .coverage-dial--secondary strong { font-size: clamp(2.1rem, 5vw, 3.3rem); }
</style>
