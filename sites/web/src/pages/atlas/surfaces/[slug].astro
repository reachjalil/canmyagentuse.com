---
import { SITE, websiteJsonLd, type ResearchSurface } from "@canmyagentuse/catalog";
import ProviderReference from "../../../components/ProviderReference.astro";
import ResearchCellTable from "../../../components/ResearchCellTable.astro";
import SiteChrome from "../../../components/SiteChrome.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  researchAtlas,
  researchSurfaceContext,
  researchSurfaceJsonPath,
  researchSurfaceMarkdownPath,
  researchVendorPath,
} from "../../../lib/research";

export function getStaticPaths() {
  return researchAtlas.seed.surfaces.map((surface) => ({
    params: { slug: surface.surface_id },
    props: { surface },
  }));
}

interface Props { surface: ResearchSurface }
const { surface } = Astro.props;
const context = researchSurfaceContext(surface);
---

<BaseLayout
  title={`${surface.surface_name} compatibility — ${SITE.name}`}
  description={`Exact-surface compatibility evidence for ${surface.surface_name}: all ${context.cells.length} atomic research features, with dated sources and unknowns preserved.`}
  canonicalPath={`/atlas/surfaces/${surface.surface_id}`}
  jsonLd={[websiteJsonLd()]}
>
  <SiteChrome>
    <main id="main" class="shell py-8">
      <p class="eyebrow">Evidence Atlas · exact surface</p>
      <h1 class="text-4xl font-semibold tracking-tight">{surface.surface_name}</h1>
      <p class="mt-3 max-w-3xl text-lg text-[color:var(--color-muted)]">
        <a href={researchVendorPath(context.vendor.vendor_id)}>{context.vendor.vendor_name}</a>
        {" / "}{context.product.product_name}. This page does not inherit claims from
        sibling products or surfaces.
      </p>
      <div class="mt-6 max-w-3xl">
        <ProviderReference
          provider={context.vendor.vendor_name}
          product={context.product.product_name}
          surface={surface.surface_type}
          homepage={context.vendor.website}
          catalogPath={researchVendorPath(context.vendor.vendor_id)}
          evidenceLabel={`${context.cells.length - context.statuses.unknown} reviewed claims`}
        />
      </div>

      <dl class="catalog-census research-detail-census mt-7">
        <div><dt>Surface ID</dt><dd>{surface.surface_id}</dd></div>
        <div><dt>Type</dt><dd>{surface.surface_type}</dd></div>
        <div><dt>Target</dt><dd>{surface.version_or_observation}</dd></div>
        <div><dt>Availability</dt><dd>{surface.availability}</dd></div>
        <div><dt>Coverage tier</dt><dd>{surface.coverage_tier}</dd></div>
        <div><dt>Supported</dt><dd class="status-yes">{context.statuses.supported}</dd></div>
        <div><dt>Partial</dt><dd class="status-partial">{context.statuses.partial}</dd></div>
        <div><dt>Explicit no</dt><dd class="status-no">{context.statuses.unsupported}</dd></div>
        <div><dt>Unknown</dt><dd class="status-unknown">{context.statuses.unknown}</dd></div>
      </dl>

      <div class="trust-banner mt-6">
        <strong>Evidence scope</strong>
        Results are documented or registry-listed as of {researchAtlas.seed.research_cutoff};
        they are not runtime conformance results. Unknown cells remain open research
        questions rather than unsupported claims.
      </div>

      <nav class="atlas-subnav mt-5" aria-label="Record formats">
        <a href="/atlas">Atlas</a>
        <a href={researchSurfaceMarkdownPath(surface.surface_id)}>Markdown</a>
        <a href={researchSurfaceJsonPath(surface.surface_id)}>JSON</a>
      </nav>

      <section class="mt-10" aria-labelledby="cells-title">
        <div class="section-heading">
          <div><p class="eyebrow">Full 49-feature grid</p><h2 id="cells-title">Compatibility cells</h2></div>
          <p>Y = supported · P = partial · N = explicit unsupported · ? = unknown.</p>
        </div>
        <ResearchCellTable cells={context.cells} focus="surface" />
      </section>
    </main>
  </SiteChrome>
</BaseLayout>
