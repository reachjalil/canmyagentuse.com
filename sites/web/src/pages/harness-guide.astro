---
import {
  breadcrumbJsonLd,
  pagePath,
  resolveMetadata,
  techArticleJsonLd,
} from "@canmyagentuse/catalog";
import { render } from "astro:content";
import SiteChrome from "../components/SiteChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { entryBySlug, publishedCollection } from "../lib/collections";

const pages = await publishedCollection("pages");
const page = entryBySlug(pages, "harness-guide");
if (!page) throw new Error("Missing harness evaluation guide.");

const { Content } = await render(page);
const metadata = resolveMetadata(page.data);
---

<BaseLayout
  title={metadata.seoTitle}
  description={metadata.description}
  canonicalPath={metadata.canonicalPath}
  socialTitle={metadata.socialTitle}
  socialDescription={metadata.socialDescription}
  socialImageAlt={metadata.previewImageAlt ?? "Agent harness evaluation checklist from Can My Agent Use."}
  modifiedTime={metadata.updated}
  jsonLd={[
    techArticleJsonLd(metadata),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Harnesses", path: "/harnesses" },
      { name: page.data.title, path: pagePath(page.data.slug) },
    ]),
  ]}
>
  <SiteChrome>
    <main id="main" class="shell py-8">
      <p class="eyebrow">Selection and review checklist</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight">{page.data.title}</h1>
      <p class="mt-4 max-w-3xl text-lg text-[color:var(--color-muted)]">{page.data.summary}</p>
      <nav class="mt-6 flex flex-wrap gap-3" aria-label="Guide actions">
        <a class="harness-action harness-action--primary" href="/harnesses">Browse exact harnesses →</a>
        <a class="harness-action" href="/compare">Compare two products →</a>
        <a class="harness-action" href="/harness-guide.md">Markdown twin →</a>
      </nav>
      <div class="prose-page mt-8">
        <Content />
      </div>
    </main>
  </SiteChrome>
</BaseLayout>
