---
import { SITE, websiteJsonLd } from "@canmyagentuse/catalog";
import ProductFinder from "../../components/ProductFinder.astro";
import SiteChrome from "../../components/SiteChrome.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publishedCollection } from "../../lib/collections";
const products = await publishedCollection("products");
---
<BaseLayout title={`Products your agent can use | ${SITE.name}`} description={SITE.description} canonicalPath="/products" jsonLd={[websiteJsonLd()]}>
  <SiteChrome showSearch={false} searchScope="product">
    <main id="main" class="shell product-page product-directory-page">
      <header class="product-intro"><p class="eyebrow">Find your next app</p><h1>Built for your workflow.<br /><span>Ready for your agent?</span></h1><p>Find the right app. Check the access. See what it takes.</p></header>
      <ProductFinder products={products.map((entry) => entry.data)} />
      <p class="product-note">Statuses are based on documentation, not live tests. “Not verified” means we need more evidence.</p>
      <a class="product-text-link" href="/harnesses">Check the agent you will use →</a>
    </main>
  </SiteChrome>
</BaseLayout>
