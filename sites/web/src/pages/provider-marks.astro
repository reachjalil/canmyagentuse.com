---
import {
  PROVIDER_MARKS,
  PROVIDER_MARK_SOURCES,
  SITE,
  breadcrumbJsonLd,
  providerMarkSource,
  providerMarkSourceUrl,
  websiteJsonLd,
} from "@canmyagentuse/catalog";
import ProviderMark from "../components/ProviderMark.astro";
import SiteChrome from "../components/SiteChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const marks = [...PROVIDER_MARKS].toSorted((left, right) =>
  left.label.localeCompare(right.label)
);
---

<BaseLayout
  title={`Brand references | ${SITE.name}`}
  description="Brand marks used to identify providers and products throughout the Can My Agent Use catalog."
  canonicalPath="/provider-marks"
  socialTitle="Brand references"
  socialDescription="A clear index of the provider and product marks used across the compatibility catalog."
  socialImageAlt="Brand reference index for the Can My Agent Use catalog."
  jsonLd={[
    websiteJsonLd(),
    breadcrumbJsonLd([
      { name: "Home", path: "/" },
      { name: "Brand references", path: "/provider-marks" },
    ]),
  ]}
>
  <SiteChrome>
    <main id="main" class="shell py-8">
      <p class="eyebrow">Product and provider index</p>
      <h1 class="text-4xl font-semibold tracking-tight">Brand references</h1>
      <p class="mt-3 max-w-3xl text-lg text-[color:var(--color-muted)]">
        Compact marks make product columns easier to scan across search,
        comparisons, matrices, and research profiles. Each mark maps to one
        named provider or product and keeps a text fallback.
      </p>

      <dl class="catalog-census mt-7">
        <div><dt>Brand marks</dt><dd>{marks.length}</dd></div>
        <div><dt>Source collections</dt><dd>{PROVIDER_MARK_SOURCES.length}</dd></div>
        <div><dt>Last reviewed</dt><dd>{marks.map((mark) => mark.reviewedAt).toSorted().at(-1)}</dd></div>
        <div><dt>Unmapped brands</dt><dd>Text fallback</dd></div>
      </dl>

      <section class="mt-10" aria-labelledby="reference-title">
        <div class="section-heading">
          <div><p class="eyebrow">Current index</p><h2 id="reference-title">Provider and product marks</h2></div>
          <p>Names stay visible beside each mark so every reference remains unambiguous.</p>
        </div>
        <div class="table-scroll mt-4">
          <table class="data-table provider-mark-table">
            <thead>
              <tr><th>Brand</th><th>Source collection</th><th>Reviewed</th></tr>
            </thead>
            <tbody>
              {marks.map((mark) => {
                const source = providerMarkSource(mark.source);
                return (
                  <tr id={mark.id}>
                    <td>
                      <ProviderMark provider={mark.label} mark={mark} variant="inline" />
                      <strong>{mark.label}</strong>
                    </td>
                    <td>
                      <a href={source.repositoryUrl} rel="noopener noreferrer">{source.label} ↗</a>
                      <small><a href={providerMarkSourceUrl(mark)} rel="noopener noreferrer">Exact asset ↗</a> · <a href={source.licenseUrl} rel="noopener noreferrer">{source.license}</a></small>
                      {mark.brandGuidelinesUrl ? (
                        <small><a href={mark.brandGuidelinesUrl} rel="noopener noreferrer">Brand guide ↗</a></small>
                      ) : null}
                      {mark.attribution ? <small>{mark.attribution}</small> : null}
                    </td>
                    <td>{mark.reviewedAt}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-12 max-w-3xl" aria-labelledby="editorial-title">
        <div class="section-heading">
          <div><p class="eyebrow">Editorial use</p><h2 id="editorial-title">Clear references, consistent presentation</h2></div>
        </div>
        <p>
          Can My Agent Use is an independent publication. Brand names and marks
          belong to their respective owners and are used to identify the products
          covered by the catalog. These are secondary references beside independent
          research, not provider endorsements. OpenWork is the separately labeled
          founding sponsor.
        </p>
        <p class="mt-4 text-sm text-[color:var(--color-muted)]">
          Asset collection licenses and provider brand terms are separate. A source
          license or review date is not provider permission or a legal conclusion.
          Downloads from providers are preserved locally with a checked SHA-256
          fingerprint; package assets use pinned releases. The <a href="https://github.com/reachjalil/canmyagentuse.com/blob/main/ops/PROVIDER-MARK-REVIEW-2026-09-04.md">review ledger</a>
          records the current product mappings, source details, and policy restrictions.
        </p>
        <p class="mt-4 text-sm text-[color:var(--color-muted)]">
          Spot an outdated mark or incorrect product mapping? Use the
          <a href="/report">correction route</a> and name the affected record.
        </p>
      </section>
    </main>
  </SiteChrome>
</BaseLayout>
