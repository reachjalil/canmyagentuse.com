---
import { SITE, organizationJsonLd, websiteJsonLd } from "@canmyagentuse/catalog";
import CompatibilityOverview from "../components/CompatibilityOverview.astro";
import ProductDirectory from "../components/ProductDirectory.astro";
import SiteChrome from "../components/SiteChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publishedCollection } from "../lib/collections";
const products = await publishedCollection("products");
---
<BaseLayout title={`Can my agent use this product? | ${SITE.name}`} description={SITE.description} canonicalPath="/" socialTitle="Can my agent use this product?" socialDescription={SITE.description} jsonLd={[websiteJsonLd(), organizationJsonLd()]}>
  <SiteChrome>
    <main id="main">
      <div class="shell product-home">
        <header class="product-hero">
          <div><p class="eyebrow">Independent research · Products your agent can use</p><h1>From “can it connect?”<br />to <em>“can it do the job?”</em></h1><p>Find out what your agent can use, what you need to set up, and where you need to step in. Start with a product. Follow the path to a first useful task.</p><div class="product-hero__links"><a class="home-action home-action--primary" href="/products">Explore products</a><a href="#compatibility">Explore agent compatibility ↓</a></div></div>
          <aside class="product-hero__aside"><span class="eyebrow">The questions that matter</span><ol><li><span>01</span> Can it sign up?</li><li><span>02</span> Can it connect my account?</li><li><span>03</span> Can it buy or subscribe?</li><li><span>04</span> Can it get work done?</li></ol><p>Each step has its own answer.</p></aside>
        </header>
        <nav class="product-use-cases" aria-label="Find a product for your task"><span>I need a product for</span><a href="/products?category=note-taking">Taking notes ↗</a><a href="/products?category=cloud-deployment">Deploying an app ↗</a><a href="/products?category=email">Working with email ↗</a><a href="/products?category=crm">Managing customers ↗</a><a href="/products?category=movie-tickets">Buying movie tickets ↗</a><a href="/products?category=shopping">Shopping ↗</a></nav>
        <section aria-labelledby="products-heading"><div class="product-section-heading"><div><p class="eyebrow">Start with a service</p><h2 id="products-heading">Can my agent use…</h2></div><a href="/products">All product guides →</a></div><ProductDirectory products={products.slice(0, 3).map((entry) => entry.data)} /></section>
        <article class="product-editorial"><div><p class="eyebrow">Agents in everyday life · Research</p><h2><a href="/news/can-an-ai-agent-buy-my-movie-ticket">Your agent found the movie.<br />Can it actually buy the ticket?</a></h2><p>AMC, Atom, partner access, and the gap between a checkout link and a confirmed seat.</p><a class="product-text-link" href="/news/can-an-ai-agent-buy-my-movie-ticket">Read the investigation →</a></div><span aria-hidden="true" class="product-editorial__ticket">ADMIT<br /><strong>01</strong><small>SHOWTIME → SEAT → RECEIPT</small></span></article>
        <p class="product-note">An API or MCP server is one part of the answer. Account creation, consent, permissions, billing, and the agent you choose determine the rest. These initial guides cite provider documentation; they have not been tested end to end.</p>
      </div>
      <CompatibilityOverview />
    </main>
  </SiteChrome>
</BaseLayout>
