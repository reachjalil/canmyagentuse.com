---
import {
  HARNESS_SURFACE_LABELS,
  MACHINE_PATHS,
  SITE,
  buildEvidenceLedger,
  buildMatrix,
  datasetJsonLd,
  organizationJsonLd,
  websiteJsonLd,
} from "@canmyagentuse/catalog";
import SiteChrome from "../components/SiteChrome.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publishedCollection } from "../lib/collections";
import { researchAtlas } from "../lib/research";

const features = await publishedCollection("features");
const harnesses = await publishedCollection("harnesses");
const categories = await publishedCollection("categories");
const news = await publishedCollection("news");
const specifications = await publishedCollection("specifications");

const startingPoints = features.filter((entry) => entry.data.highlight).slice(0, 6);
const matrix = buildMatrix(
  features.map((entry) => entry.data),
  harnesses.map((entry) => entry.data)
);
const sourcedCells = matrix.filter((cell) => cell.status !== "unknown").length;
const cellCount = matrix.length;
const evidenceRecords = buildEvidenceLedger(features.map((entry) => entry.data));
const reviewedCapabilities = new Set(
  matrix.filter((cell) => cell.status !== "unknown").map((cell) => cell.feature)
).size;
const atlasReport = researchAtlas.report;

const categoryRows = categories.map((category) => ({
  ...category,
  featureCount: features.filter((feature) => feature.data.category === category.data.slug).length,
}));

const surfaceCoverage = (["web", "desktop", "cli"] as const).map((surface) => {
  const surfaceHarnesses = harnesses.filter((entry) => entry.data.surface === surface);
  const harnessIds = new Set(surfaceHarnesses.map((entry) => entry.data.slug));
  const cells = matrix.filter((cell) => harnessIds.has(cell.harness));
  const sourced = cells.filter((cell) => cell.status !== "unknown").length;
  return {
    surface,
    label: HARNESS_SURFACE_LABELS[surface],
    products: surfaceHarnesses.length,
    sourced,
    total: cells.length,
    percent: cells.length ? Math.round((sourced / cells.length) * 100) : 0,
  };
});

const statusKey = [
  { status: "yes", label: "Yes", meaning: "A public source supports the current claim." },
  { status: "partial", label: "Partial", meaning: "The capability has a documented limit." },
  { status: "no", label: "No", meaning: "A current source says it is unsupported." },
  { status: "unknown", label: "Unknown", meaning: "Evidence is missing or unclear." },
  { status: "na", label: "N/A", meaning: "The capability does not apply to this product." },
] as const;
---

<BaseLayout
  title={`Compare AI Agent Capabilities | ${SITE.name}`}
  description={SITE.description}
  canonicalPath="/"
  socialTitle="Know what your AI agent can actually do"
  socialDescription="Pick a capability, compare exact products, and check the public evidence behind every answer."
  socialImageAlt="Can My Agent Use social card reading ‘Know what your AI agent can actually do’ beside a three-step path from question to public evidence."
  jsonLd={[websiteJsonLd(), organizationJsonLd(), datasetJsonLd(cellCount)]}
>
  <SiteChrome showIndex>
    <main id="main" class="home-board">
      <div class="shell home-board__inner">
        <header class="home-intro">
          <div>
            <p class="home-kicker">Independent compatibility catalog</p>
            <h1>Check capability support. Read the source.</h1>
          </div>
          <p>
            Search {features.length} capabilities across {harnesses.length} exact web,
            desktop, and CLI product columns. Unknown means no public source has been
            reviewed for that cell.
          </p>
        </header>

        <dl class="home-census" aria-label="Catalog totals">
          <div><dt>Capabilities</dt><dd>{features.length}</dd></div>
          <div><dt>Product columns</dt><dd>{harnesses.length}</dd></div>
          <div><dt>Reviewed capabilities</dt><dd>{reviewedCapabilities}</dd></div>
          <div><dt>Sourced cells</dt><dd>{sourcedCells}</dd></div>
          <div><dt>Public source records</dt><dd>{evidenceRecords.length}</dd></div>
        </dl>

        <div class="home-grid">
          <section class="home-card home-card--atlas" aria-labelledby="atlas-title">
            <header class="home-card__head">
              <h2 id="atlas-title">Evidence Atlas</h2>
              <a href="/atlas">Open atlas</a>
            </header>
            <p class="home-card__lead">
              The full dataset dated {researchAtlas.seed.research_cutoff} includes{" "}
              {atlasReport.vendors} vendors, {atlasReport.products} products,{" "}
              {atlasReport.surfaces} exact surfaces, {atlasReport.features} atomic
              capabilities, and{" "}
              {atlasReport.compatibilityCells.toLocaleString("en-US")}{" "}
              compatibility cells. Adapters, IDE modes, cloud agents, and protocol
              roles remain separate records. The curated catalog below uses{" "}
              {harnesses.length} product columns.
            </p>
            <dl class="home-atlas-stats">
              <div><dt>Supported</dt><dd class="status-yes">{atlasReport.statuses.supported}</dd></div>
              <div><dt>Partial</dt><dd class="status-partial">{atlasReport.statuses.partial}</dd></div>
              <div><dt>Explicit no</dt><dd class="status-no">{atlasReport.statuses.unsupported}</dd></div>
              <div><dt>Unknown</dt><dd class="status-unknown">{atlasReport.statuses.unknown.toLocaleString("en-US")}</dd></div>
              <div><dt>Sources</dt><dd>{atlasReport.sources}</dd></div>
            </dl>
            <p class="home-atlas-links">
              <a href="/atlas/sources">Source ledger</a>
              <a href={MACHINE_PATHS.atlasJson}>JSON index</a>
              <a href="/atlas.md">Markdown index</a>
            </p>
          </section>

          <section class="home-card home-card--start" aria-labelledby="start-title">
            <header class="home-card__head">
              <h2 id="start-title">Start here</h2>
              <a href="/features">All capabilities</a>
            </header>
            <ol class="home-link-list home-link-list--numbered">
              {
                startingPoints.map((feature) => (
                  <li>
                    <a href={`/features/${feature.data.slug}`}>{feature.data.title}</a>
                    <span>{feature.data.summary}</span>
                  </li>
                ))
              }
            </ol>
          </section>

          <section class="home-card home-card--groups" aria-labelledby="groups-title">
            <header class="home-card__head">
              <h2 id="groups-title">Browse by job</h2>
            </header>
            <ul class="home-group-list">
              {
                categoryRows.map((category) => (
                  <li>
                    <a href={`/categories/${category.data.slug}`}>
                      <span>{category.data.title}</span>
                      <small>{category.featureCount}</small>
                    </a>
                    <p>{category.data.summary}</p>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="home-card home-card--coverage" aria-labelledby="coverage-title">
            <header class="home-card__head">
              <h2 id="coverage-title">Research coverage</h2>
              <a href="/coverage">Open report</a>
            </header>
            <p class="home-card__note">
              Sourced current cells by product type. This measures catalog work,
              not product quality.
            </p>
            <div class="home-coverage-list">
              {
                surfaceCoverage.map((row) => (
                  <div class="home-coverage-row">
                    <div>
                      <span>{row.label}</span>
                      <small>{row.products} products</small>
                    </div>
                    <div class="home-coverage-track" aria-hidden="true">
                      <span style={`width: ${row.percent}%`} />
                    </div>
                    <strong>{row.sourced}/{row.total}</strong>
                  </div>
                ))
              }
            </div>
            <p class="home-coverage-total">
              <strong>{sourcedCells}</strong> of <strong>{cellCount}</strong> current
              cells have a sourced status.
            </p>
          </section>

          <section class="home-card home-card--changes" aria-labelledby="changes-title">
            <header class="home-card__head">
              <h2 id="changes-title">Recent catalog changes</h2>
              <a href="/news">All changes</a>
            </header>
            <ul class="home-news-list">
              {
                news.slice(0, 4).map((item) => (
                  <li>
                    <time datetime={item.data.published?.toISOString()}>
                      {item.data.published?.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </time>
                    <a href={`/news/${item.data.slug}`}>{item.data.title}</a>
                    <p>{item.data.summary}</p>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="home-card home-card--compare" aria-labelledby="compare-title">
            <header class="home-card__head">
              <h2 id="compare-title">Compare products</h2>
            </header>
            <p class="home-card__lead">
              Pick two exact product columns and compare their current capability
              states side by side.
            </p>
            <div class="home-actions">
              <a class="home-action home-action--primary" href="/compare">Choose products</a>
              <a class="home-action" href="/matrix">Open the full matrix</a>
              <a class="home-action" href="/harnesses">Browse product columns</a>
            </div>
          </section>

          <section class="home-card home-card--data" aria-labelledby="data-title">
            <header class="home-card__head">
              <h2 id="data-title">Use the catalog data</h2>
            </header>
            <p class="home-card__note">
              HTML, Markdown, and JSON are generated from the same records.
            </p>
            <ul class="home-data-list">
              <li><a href={MACHINE_PATHS.llms}>Agent entry point</a><code>/llms.txt</code></li>
              <li><a href={MACHINE_PATHS.matrixJson}>Matrix JSON</a><code>/api/v1/matrix.json</code></li>
              <li><a href={MACHINE_PATHS.atlasJson}>Evidence Atlas JSON</a><code>/api/v1/atlas.json</code></li>
              <li><a href={MACHINE_PATHS.openapi}>OpenAPI document</a><code>/api/v1/openapi.json</code></li>
              <li><a href={MACHINE_PATHS.catalogSkill}>Read-only catalog skill</a><code>/skills/can-my-agent-use/SKILL.md</code></li>
              <li><a href="/prompt">Canonical agent prompt</a><code>/prompt.txt</code></li>
            </ul>
          </section>

          <section class="home-card home-card--status" aria-labelledby="status-title">
            <header class="home-card__head">
              <h2 id="status-title">Status key</h2>
              <a href="/methodology">Read the method</a>
            </header>
            <ul class="home-status-list">
              {
                statusKey.map((item) => (
                  <li>
                    <span class={`home-status home-status--${item.status}`}>{item.label}</span>
                    <p>{item.meaning}</p>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="home-card home-card--contribute" aria-labelledby="contribute-title">
            <header class="home-card__head">
              <h2 id="contribute-title">Missing a capability?</h2>
            </header>
            <p class="home-card__lead">
              A proposal needs a neutral capability name, an exact product target,
              its limits, a public source, and a review date.
            </p>
            <a class="home-action home-action--primary" href="/contribute">
              Contribute evidence
            </a>
          </section>
        </div>

        <footer class="home-board__foot">
          <p>{SITE.foundationNotice}</p>
          <p>{specifications.length} specification references are published.</p>
        </footer>
      </div>
    </main>
  </SiteChrome>
</BaseLayout>
