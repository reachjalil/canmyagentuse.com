{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!!**/.tmp",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      "!**/.astro",
      "!**/.wrangler",
      "!**/coverage",
      "!**/.agents",
      "!**/.harness/resources/skills",
      "!**/ops",
      "!**/md/deep-dive-research-canmyagentuse-2026-08-28",
      "!**/md/deep-dive-research-canmyagentuse-compatibility-seed-2026-08-28",
      "!**/worker-configuration.generated.d.ts",
      "!**/content"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": [
      "**/*.{js,jsx,ts,tsx,mts,cts,cjs,mjs,json,jsonc,css}",
      "!**/.harness/resources/skills/**",
      "!**/md/deep-dive-research-canmyagentuse-2026-08-28/**"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "includes": [
      "**/*.{js,jsx,ts,tsx,mts,cts,cjs,mjs,json,jsonc,css}",
      "!**/.harness/resources/skills/**",
      "!**/md/deep-dive-research-canmyagentuse-2026-08-28/**"
    ],
    "rules": {
      "correctness": {
        "noUnusedImports": "error",
        "useHookAtTopLevel": "error"
      }
    }
  },
  "assist": {
    "enabled": false,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on"
        }
      }
    }
  }
}
